import Mathlib

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-!
# Context-free grammars and pushdown automata

This module develops context-free languages from scratch and proves the
Chomsky–Evey equivalence: a language is generated by a context-free grammar
exactly when it is accepted by a pushdown automaton (by empty stack).

The derivation relation `Yields g α w` says that the sentential form `α`
derives the terminal word `w`.  Its two structural lemmas, `Yields.append` and
`Yields.split`, are what make both halves of the equivalence go through.

On the automaton side, `PStep` is a single move and `Reach` its reflexive
transitive closure; `reach_frame` says a computation may be run underneath extra
stack and extra input.

* `Grammar.toPDA` turns a grammar into a pushdown automaton whose stack *is* the
  sentential form, and `yields_iff_reach` proves the two agree.
* `PDA.toGrammar` turns an automaton into a grammar whose nonterminals are stack
  symbols (plus a fresh start symbol), and `grammar_language_toGrammar` proves
  the same.
* `contextFree_iff_pda` combines the two.
-/

namespace UAM.ContextFree

universe u

variable {N T Γ : Type u}

/-! ## Grammars -/

/-- A context-free grammar: a rule relation and a start symbol. -/
structure Grammar (N T : Type u) where
  rule : N → List (N ⊕ T) → Prop
  start : N

/-- `Yields g α w` : the sentential form `α` derives the terminal word `w`. -/
inductive Yields (g : Grammar N T) : List (N ⊕ T) → List T → Prop
  | nil : Yields g [] []
  | term {a : T} {α : List (N ⊕ T)} {w : List T} :
      Yields g α w → Yields g (Sum.inr a :: α) (a :: w)
  | nonterm {A : N} {β α : List (N ⊕ T)} {u w : List T} :
      g.rule A β → Yields g β u → Yields g α w → Yields g (Sum.inl A :: α) (u ++ w)

/-- The language generated by a grammar. -/
def Grammar.language (g : Grammar N T) : Set (List T) := {w | Yields g [Sum.inl g.start] w}

theorem Yields.eq_nil_of_nil {g : Grammar N T} {w : List T} (h : Yields g [] w) : w = [] := by
  cases h; rfl

/-- Derivations concatenate. -/
theorem Yields.append {g : Grammar N T} {α β : List (N ⊕ T)} {u v : List T}
    (hα : Yields g α u) (hβ : Yields g β v) : Yields g (α ++ β) (u ++ v) := by
  induction hα with
  | nil => simpa using hβ
  | term _ ih => exact Yields.term ih
  | nonterm hr hsub _ _ ihtail =>
    rw [List.cons_append, List.append_assoc]
    exact Yields.nonterm hr hsub ihtail

/-- Derivations split along a decomposition of the sentential form. -/
theorem Yields.split {g : Grammar N T} {α β : List (N ⊕ T)} {w : List T}
    (h : Yields g (α ++ β) w) : ∃ u v, w = u ++ v ∧ Yields g α u ∧ Yields g β v := by
  induction α generalizing w with
  | nil => exact ⟨[], w, rfl, Yields.nil, by simpa using h⟩
  | cons x α' ih =>
    cases x with
    | inr a =>
      rw [List.cons_append] at h
      cases h with
      | term hrest =>
        obtain ⟨u, v, rfl, hu, hv⟩ := ih hrest
        exact ⟨a :: u, v, rfl, Yields.term hu, hv⟩
    | inl A =>
      rw [List.cons_append] at h
      cases h with
      | nonterm hr hsub hrest =>
        obtain ⟨u, v, rfl, hu, hv⟩ := ih hrest
        exact ⟨_ ++ u, v, by rw [List.append_assoc], Yields.nonterm hr hsub hu, hv⟩

/-- Inversion for a derivation from a single nonterminal. -/
theorem yields_singleton_inv {g : Grammar N T} {A : N} {w : List T}
    (h : Yields g [Sum.inl A] w) : ∃ β, g.rule A β ∧ Yields g β w := by
  cases h with
  | nonterm hr hβ hrest =>
    have hv := hrest.eq_nil_of_nil
    subst hv
    exact ⟨_, hr, by simpa using hβ⟩

/-! ## Pushdown automata -/

/-- A pushdown automaton, accepting by empty stack. -/
structure PDA (Γ T : Type u) where
  read : Γ → T → List Γ → Prop
  eps : Γ → List Γ → Prop
  initStack : List Γ

/-- A configuration: the stack and the remaining input. -/
abbrev Config (Γ T : Type u) := List Γ × List T

/-- A single move of a pushdown automaton. -/
inductive PStep (M : PDA Γ T) : Config Γ T → Config Γ T → Prop
  | read {Z : Γ} {a : T} {γ σ : List Γ} {w : List T} :
      M.read Z a γ → PStep M (Z :: σ, a :: w) (γ ++ σ, w)
  | eps {Z : Γ} {γ σ : List Γ} {w : List T} :
      M.eps Z γ → PStep M (Z :: σ, w) (γ ++ σ, w)

/-- Reachability between configurations. -/
def Reach (M : PDA Γ T) : Config Γ T → Config Γ T → Prop := Relation.ReflTransGen (PStep M)

/-- Acceptance by empty stack. -/
def PDA.accepts (M : PDA Γ T) (w : List T) : Prop := Reach M (M.initStack, w) ([], [])

/-- The language accepted by a pushdown automaton. -/
def PDA.language (M : PDA Γ T) : Set (List T) := {w | M.accepts w}

theorem not_pstep_of_nil_stack {M : PDA Γ T} {w : List T} {c : Config Γ T} :
    ¬ PStep M ([], w) c := by
  intro h; cases h

/-- A move can be performed underneath extra stack and extra input. -/
theorem pstep_frame {M : PDA Γ T} {c₁ c₂ : Config Γ T} (h : PStep M c₁ c₂)
    (τ : List Γ) (v : List T) :
    PStep M (c₁.1 ++ τ, c₁.2 ++ v) (c₂.1 ++ τ, c₂.2 ++ v) := by
  cases h with
  | @read Z a γ σ w hr =>
    have := PStep.read (M := M) (Z := Z) (a := a) (γ := γ) (σ := σ ++ τ) (w := w ++ v) hr
    simpa [List.append_assoc] using this
  | @eps Z γ σ w he =>
    have := PStep.eps (M := M) (Z := Z) (γ := γ) (σ := σ ++ τ) (w := w ++ v) he
    simpa [List.append_assoc] using this

/-- A computation can be run underneath extra stack and extra input. -/
theorem reach_frame_general {M : PDA Γ T} {c₁ c₂ : Config Γ T} (h : Reach M c₁ c₂)
    (τ : List Γ) (v : List T) :
    Reach M (c₁.1 ++ τ, c₁.2 ++ v) (c₂.1 ++ τ, c₂.2 ++ v) := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail _ hstep ih => exact ih.tail (pstep_frame hstep τ v)

/-- An accepting computation composes with the rest of the stack and input. -/
theorem reach_frame {M : PDA Γ T} {σ : List Γ} {w : List T}
    (h : Reach M (σ, w) ([], [])) (τ : List Γ) (v : List T) :
    Reach M (σ ++ τ, w ++ v) (τ, v) := by
  simpa using reach_frame_general h τ v

theorem reach_comp {M : PDA Γ T} {c₁ c₂ c₃ : Config Γ T}
    (h₁ : Reach M c₁ c₂) (h₂ : Reach M c₂ c₃) : Reach M c₁ c₃ :=
  Relation.ReflTransGen.trans h₁ h₂

/-! ## Counted reachability -/

/-- Reachability in exactly `n` moves; this supplies an induction measure. -/
inductive ReachN (M : PDA Γ T) : ℕ → Config Γ T → Config Γ T → Prop
  | refl (c : Config Γ T) : ReachN M 0 c c
  | head {n : ℕ} {c₁ c₂ c₃ : Config Γ T} :
      PStep M c₁ c₂ → ReachN M n c₂ c₃ → ReachN M (n + 1) c₁ c₃

theorem ReachN.tail {M : PDA Γ T} {n : ℕ} {c₁ c₂ c₃ : Config Γ T}
    (h : ReachN M n c₁ c₂) (hstep : PStep M c₂ c₃) : ReachN M (n + 1) c₁ c₃ := by
  induction h with
  | refl c => exact ReachN.head hstep (ReachN.refl _)
  | head hs _ ih => exact ReachN.head hs (ih hstep)

theorem exists_reachN_of_reach {M : PDA Γ T} {c₁ c₂ : Config Γ T} (h : Reach M c₁ c₂) :
    ∃ n, ReachN M n c₁ c₂ := by
  induction h with
  | refl => exact ⟨0, ReachN.refl _⟩
  | tail _ hstep ih =>
    obtain ⟨n, hn⟩ := ih
    exact ⟨n + 1, hn.tail hstep⟩

theorem reach_of_reachN {M : PDA Γ T} {n : ℕ} {c₁ c₂ : Config Γ T} (h : ReachN M n c₁ c₂) :
    Reach M c₁ c₂ := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | head hstep _ ih => exact Relation.ReflTransGen.head hstep ih

theorem reachN_zero_inv {M : PDA Γ T} {c₁ c₂ : Config Γ T} (h : ReachN M 0 c₁ c₂) : c₁ = c₂ := by
  cases h; rfl

theorem reachN_succ_inv {M : PDA Γ T} {n : ℕ} {c₁ c₃ : Config Γ T}
    (h : ReachN M (n + 1) c₁ c₃) : ∃ c₂, PStep M c₁ c₂ ∧ ReachN M n c₂ c₃ := by
  cases h with
  | head hstep hrest => exact ⟨_, hstep, hrest⟩

theorem pstep_inv {M : PDA Γ T} {c₁ c₂ : Config Γ T} (h : PStep M c₁ c₂) :
    (∃ Z a γ σ w, c₁ = (Z :: σ, a :: w) ∧ c₂ = (γ ++ σ, w) ∧ M.read Z a γ) ∨
    (∃ Z γ σ w, c₁ = (Z :: σ, w) ∧ c₂ = (γ ++ σ, w) ∧ M.eps Z γ) := by
  cases h with
  | read hr => exact Or.inl ⟨_, _, _, _, _, rfl, rfl, hr⟩
  | eps he => exact Or.inr ⟨_, _, _, _, rfl, rfl, he⟩

/-! ## From grammars to automata -/

/-- The pushdown automaton of a grammar: its stack is the sentential form. -/
def Grammar.toPDA (g : Grammar N T) : PDA (N ⊕ T) T where
  read X a γ := X = Sum.inr a ∧ γ = []
  eps X γ := ∃ A, X = Sum.inl A ∧ g.rule A γ
  initStack := [Sum.inl g.start]

/-- Every derivation is an accepting computation. -/
theorem reach_of_yields {g : Grammar N T} {α : List (N ⊕ T)} {w : List T}
    (h : Yields g α w) : Reach g.toPDA (α, w) ([], []) := by
  induction h with
  | nil => exact Relation.ReflTransGen.refl
  | @term a α w _ ih =>
    refine Relation.ReflTransGen.head ?_ ih
    have hstep := PStep.read (M := g.toPDA) (Z := (Sum.inr a : N ⊕ T)) (a := a)
      (γ := ([] : List (N ⊕ T))) (σ := α) (w := w) ⟨rfl, rfl⟩
    simpa using hstep
  | @nonterm A β α u w hr _ _ ihβ ihα =>
    refine Relation.ReflTransGen.head (b := (β ++ α, u ++ w)) ?_ ?_
    · exact PStep.eps (M := g.toPDA) (Z := (Sum.inl A : N ⊕ T)) (γ := β) (σ := α) (w := u ++ w)
        ⟨A, rfl, hr⟩
    · exact reach_comp (reach_frame ihβ α w) ihα

/-- Every accepting computation is a derivation. -/
theorem yields_of_reachN {g : Grammar N T} :
    ∀ (n : ℕ) (α : List (N ⊕ T)) (w : List T), ReachN g.toPDA n (α, w) ([], []) →
      Yields g α w := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro α w h
    rcases n with _ | m
    · have hc := reachN_zero_inv h
      simp only [Prod.mk.injEq] at hc
      rw [hc.1, hc.2]
      exact Yields.nil
    · obtain ⟨c₂, hstep, hrest⟩ := reachN_succ_inv h
      rcases pstep_inv hstep with ⟨Z, a, γ, σ, w', h1, h2, hr⟩ | ⟨Z, γ, σ, w', h1, h2, he⟩
      · simp only [Prod.mk.injEq] at h1
        obtain ⟨hZ, hγ⟩ := hr
        subst hZ; subst hγ; subst h2
        obtain ⟨hα, hw⟩ := h1
        subst hα; subst hw
        exact Yields.term (ih m (Nat.lt_succ_self m) σ w' (by simpa using hrest))
      · obtain ⟨A, hZ, hrule⟩ := he
        simp only [Prod.mk.injEq] at h1
        subst hZ; subst h2
        obtain ⟨hα, hw⟩ := h1
        subst hα
        have hy : Yields g (γ ++ σ) w := by
          rw [hw]; exact ih m (Nat.lt_succ_self m) (γ ++ σ) w' hrest
        obtain ⟨u, v, rfl, hu, hv⟩ := hy.split
        exact Yields.nonterm hrule hu hv

theorem yields_of_reach {g : Grammar N T} {α : List (N ⊕ T)} {w : List T}
    (h : Reach g.toPDA (α, w) ([], [])) : Yields g α w := by
  obtain ⟨n, hn⟩ := exists_reachN_of_reach h
  exact yields_of_reachN n α w hn

/-- Derivation and acceptance agree. -/
theorem yields_iff_reach {g : Grammar N T} (α : List (N ⊕ T)) (w : List T) :
    Yields g α w ↔ Reach g.toPDA (α, w) ([], []) :=
  ⟨reach_of_yields, yields_of_reach⟩

/-- The automaton of a grammar accepts exactly the generated language. -/
theorem pda_language_toPDA (g : Grammar N T) : g.toPDA.language = g.language := by
  ext w
  exact (yields_iff_reach [Sum.inl g.start] w).symm

/-! ## From automata to grammars -/

section ToGrammar

variable (T)

/-- A stack symbol, viewed as a nonterminal of the generated grammar. -/
def stackSym (Z : Γ) : Option Γ ⊕ T := Sum.inl (some Z)

/-- A stack, viewed as a sentential form. -/
def stackWord (σ : List Γ) : List (Option Γ ⊕ T) := σ.map (stackSym T)

end ToGrammar

@[simp] theorem stackWord_nil : stackWord T ([] : List Γ) = [] := rfl

@[simp] theorem stackWord_cons (Z : Γ) (σ : List Γ) :
    stackWord T (Z :: σ) = stackSym T Z :: stackWord T σ := rfl

@[simp] theorem stackWord_append (σ τ : List Γ) :
    stackWord T (σ ++ τ) = stackWord T σ ++ stackWord T τ := by simp [stackWord]

/-- The grammar of a pushdown automaton: nonterminals are stack symbols, plus a
fresh start symbol that expands to the initial stack. -/
def PDA.toGrammar (M : PDA Γ T) : Grammar (Option Γ) T where
  rule
    | none, β => β = stackWord T M.initStack
    | some Z, β =>
        (∃ a γ, M.read Z a γ ∧ β = Sum.inr a :: stackWord T γ) ∨
        (∃ γ, M.eps Z γ ∧ β = stackWord T γ)
  start := none

/-! ### Decomposing a terminal prefix followed by a stack -/

/-- A sentential form of the shape "terminals then stack". -/
def prefixWord (pre : List T) (σ : List Γ) : List (Option Γ ⊕ T) :=
  pre.map Sum.inr ++ stackWord T σ

theorem prefixWord_eq_nil {pre : List T} {σ : List Γ} (h : prefixWord pre σ = []) :
    pre = [] ∧ σ = [] := by
  cases pre with
  | cons a t => simp [prefixWord] at h
  | nil =>
    cases σ with
    | nil => exact ⟨rfl, rfl⟩
    | cons Z σ' => simp [prefixWord, stackWord, stackSym] at h

theorem prefixWord_eq_inr {pre : List T} {σ : List Γ} {a : T} {rest : List (Option Γ ⊕ T)}
    (h : prefixWord pre σ = Sum.inr a :: rest) :
    ∃ pre', pre = a :: pre' ∧ rest = prefixWord pre' σ := by
  cases pre with
  | nil =>
    exfalso
    cases σ with
    | nil => simp [prefixWord] at h
    | cons Z σ' => simp [prefixWord, stackWord, stackSym] at h
  | cons b t =>
    simp only [prefixWord, List.map_cons, List.cons_append, List.cons.injEq,
      Sum.inr.injEq] at h
    exact ⟨t, by rw [h.1], h.2.symm⟩

theorem prefixWord_eq_inl {pre : List T} {σ : List Γ} {A : Option Γ}
    {rest : List (Option Γ ⊕ T)} (h : prefixWord pre σ = Sum.inl A :: rest) :
    ∃ Z σ', pre = [] ∧ σ = Z :: σ' ∧ A = some Z ∧ rest = stackWord T σ' := by
  cases pre with
  | cons b t => simp [prefixWord] at h
  | nil =>
    cases σ with
    | nil => simp [prefixWord] at h
    | cons Z σ' =>
      simp only [prefixWord, List.map_nil, List.nil_append, stackWord_cons, stackSym,
        List.cons.injEq, Sum.inl.injEq] at h
      exact ⟨Z, σ', rfl, rfl, h.1.symm, h.2.symm⟩

/-- Every accepting computation of the automaton is a derivation of its grammar. -/
theorem yields_toGrammar_of_reachN {M : PDA Γ T} :
    ∀ (n : ℕ) (σ : List Γ) (w : List T), ReachN M n (σ, w) ([], []) →
      Yields M.toGrammar (stackWord T σ) w := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro σ w h
    rcases n with _ | m
    · have hc := reachN_zero_inv h
      simp only [Prod.mk.injEq] at hc
      rw [hc.1, hc.2]
      exact Yields.nil
    · obtain ⟨c₂, hstep, hrest⟩ := reachN_succ_inv h
      rcases pstep_inv hstep with ⟨Z, a, γ, σ₀, w', h1, h2, hr⟩ | ⟨Z, γ, σ₀, w', h1, h2, he⟩
      · simp only [Prod.mk.injEq] at h1
        subst h2
        obtain ⟨hσ, hw⟩ := h1
        subst hσ; subst hw
        have hy : Yields M.toGrammar (stackWord T (γ ++ σ₀)) w' :=
          ih m (Nat.lt_succ_self m) (γ ++ σ₀) w' hrest
        rw [stackWord_append] at hy
        obtain ⟨u, v, rfl, hu, hv⟩ := hy.split
        have hrule : M.toGrammar.rule (some Z) (Sum.inr a :: stackWord T γ) :=
          Or.inl ⟨a, γ, hr, rfl⟩
        have hres := Yields.nonterm hrule (Yields.term hu) hv
        simpa [stackWord, stackSym] using hres
      · simp only [Prod.mk.injEq] at h1
        subst h2
        obtain ⟨hσ, hw⟩ := h1
        subst hσ
        have hy : Yields M.toGrammar (stackWord T (γ ++ σ₀)) w := by
          rw [hw]; exact ih m (Nat.lt_succ_self m) (γ ++ σ₀) w' hrest
        rw [stackWord_append] at hy
        obtain ⟨u, v, hw2, hu, hv⟩ := hy.split
        rw [hw2]
        have hrule : M.toGrammar.rule (some Z) (stackWord T γ) := Or.inr ⟨γ, he, rfl⟩
        have hres := Yields.nonterm hrule hu hv
        simpa [stackWord, stackSym] using hres

/-- Every derivation from a stack (possibly behind a terminal prefix) is an
accepting computation. -/
theorem reach_of_yields_toGrammar_aux {M : PDA Γ T} :
    ∀ (α : List (Option Γ ⊕ T)) (w : List T), Yields M.toGrammar α w →
      ∀ (pre : List T) (σ : List Γ), α = prefixWord pre σ →
        ∃ w', w = pre ++ w' ∧ Reach M (σ, w') ([], []) := by
  intro α w h
  induction h with
  | nil =>
    intro pre σ hα
    obtain ⟨rfl, rfl⟩ := prefixWord_eq_nil hα.symm
    exact ⟨[], rfl, Relation.ReflTransGen.refl⟩
  | @term a α w _ ihtail =>
    intro pre σ hα
    obtain ⟨pre', rfl, hrest⟩ := prefixWord_eq_inr hα.symm
    obtain ⟨w', rfl, hreach⟩ := ihtail pre' σ hrest
    exact ⟨w', rfl, hreach⟩
  | @nonterm A β α u v hr _ _ ihβ ihα =>
    intro pre σ hα
    obtain ⟨Z, σ', rfl, rfl, rfl, hrest⟩ := prefixWord_eq_inl hα.symm
    rcases hr with ⟨a, γ, hread, rfl⟩ | ⟨γ, heps, rfl⟩
    · obtain ⟨u', hu, hγ⟩ := ihβ [a] γ (by simp [prefixWord])
      obtain ⟨v', hv, hσ'⟩ := ihα [] σ' (by simpa [prefixWord] using hrest)
      refine ⟨u ++ v, by simp, ?_⟩
      rw [hu, hv]
      simp only [List.nil_append, List.cons_append]
      refine Relation.ReflTransGen.head (PStep.read (M := M) (σ := σ') hread) ?_
      exact reach_comp (reach_frame hγ σ' v') hσ'
    · obtain ⟨u', hu, hγ⟩ := ihβ [] γ (by simp [prefixWord])
      obtain ⟨v', hv, hσ'⟩ := ihα [] σ' (by simpa [prefixWord] using hrest)
      refine ⟨u ++ v, by simp, ?_⟩
      rw [hu, hv]
      simp only [List.nil_append]
      refine Relation.ReflTransGen.head (PStep.eps (M := M) (σ := σ') heps) ?_
      exact reach_comp (reach_frame hγ σ' v') hσ'

theorem reach_of_yields_toGrammar {M : PDA Γ T} {σ : List Γ} {w : List T}
    (h : Yields M.toGrammar (stackWord T σ) w) : Reach M (σ, w) ([], []) := by
  obtain ⟨w', hw, hreach⟩ :=
    reach_of_yields_toGrammar_aux _ _ h [] σ (by simp [prefixWord])
  simpa [hw] using hreach

/-- The grammar of an automaton generates exactly the accepted language. -/
theorem grammar_language_toGrammar (M : PDA Γ T) : M.toGrammar.language = M.language := by
  ext w
  constructor
  · intro h
    have h' : Yields M.toGrammar [Sum.inl none] w := h
    obtain ⟨β, u, v, hr, hβ, hrest, rfl⟩ :
        ∃ β u v, M.toGrammar.rule none β ∧ Yields M.toGrammar β u ∧
          Yields M.toGrammar [] v ∧ w = u ++ v := by
      cases h' with
      | nonterm hr hβ hrest => exact ⟨_, _, _, hr, hβ, hrest, rfl⟩
    have hv : v = [] := hrest.eq_nil_of_nil
    have hβ' : β = stackWord T M.initStack := hr
    subst hβ'; subst hv
    have := reach_of_yields_toGrammar hβ
    simpa [PDA.accepts] using this
  · intro h
    have hy : Yields M.toGrammar (stackWord T M.initStack) w := by
      obtain ⟨n, hn⟩ := exists_reachN_of_reach h
      exact yields_toGrammar_of_reachN n M.initStack w hn
    have hrule : M.toGrammar.rule M.toGrammar.start (stackWord T M.initStack) := rfl
    have hres := Yields.nonterm hrule hy (Yields.nil (g := M.toGrammar))
    simpa using hres

/-! ## The equivalence -/

/-- **Chomsky–Evey.** A language is context-free exactly when some pushdown
automaton accepts it. -/
theorem contextFree_iff_pda (L : Set (List T)) :
    (∃ (N : Type u) (g : Grammar N T), g.language = L) ↔
    (∃ (Γ : Type u) (M : PDA Γ T), M.language = L) := by
  constructor
  · rintro ⟨N, g, rfl⟩
    exact ⟨N ⊕ T, g.toPDA, pda_language_toPDA g⟩
  · rintro ⟨Γ, M, rfl⟩
    exact ⟨Option Γ, M.toGrammar, grammar_language_toGrammar M⟩

end UAM.ContextFree
