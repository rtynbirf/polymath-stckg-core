import RequestProject.UAM_Separation
import RequestProject.UAM_ContextFreeFinitary

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-!
# The regular languages are a proper subclass of the context-free ones

`UAM_Separation` proves that `aⁿbⁿ` is generated by a grammar and is not
regular.  Now that `IsCFL` demands a grammar with *finitely many* productions,
the separation can be stated for the honest class: the two-rule grammar
`S → ε | a S b` is finitary, so

  `regular_lt_isCFL : (∀ L, L.IsRegular → IsCFL L) ∧ IsCFL anbn ∧ ¬ anbn.IsRegular`.
-/

namespace UAM.Separation

open UAM.ContextFree

/-- The grammar `S → ε | a S b` has exactly two productions. -/
theorem finitary_anbnGrammar : anbnGrammar.Finitary := by
  refine Set.Finite.subset
    ((Set.finite_singleton (((), []) : Unit × List (Unit ⊕ Bool))).union
      (Set.finite_singleton
        (((), [Sum.inr false, Sum.inl (), Sum.inr true]) : Unit × List (Unit ⊕ Bool)))) ?_
  rintro ⟨A, β⟩ hr
  rcases hr with h | h
  · have h' : β = [] := h
    exact Or.inl (by simp [h'])
  · have h' : β = [Sum.inr false, Sum.inl (), Sum.inr true] := h
    exact Or.inr (by simp [h'])

/-- `aⁿbⁿ` is context-free in the strict sense. -/
theorem anbn_isCFL : IsCFL anbn :=
  ⟨Unit, anbnGrammar, finitary_anbnGrammar, anbnGrammar_language⟩

/-- **The regular languages are a proper subclass of the context-free ones.** -/
theorem regular_lt_isCFL :
    (∀ L : Language Bool, L.IsRegular → IsCFL L) ∧ IsCFL anbn ∧ ¬ Language.IsRegular anbn :=
  ⟨fun _ h => isCFL_of_isRegular h, anbn_isCFL, anbn_not_regular⟩

end UAM.Separation
