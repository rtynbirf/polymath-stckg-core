import RequestProject.OSA4.Identity

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-!
# Audit: the type lattice

The subtype relation of `RequestProject.OSA4.Identity` is generated by the
declared parent edges.  Ranking the six types by depth shows that the generated
relation is a partial order with `Bot` as least and `Top` as greatest element:

* `rank_lt_of_direct`, `rank_le_of_isSubtype` — the rank is a strictly
  increasing potential along declared edges;
* `isSubtype_antisymm` and `not_isSubtype_of_rank_lt` — the type hierarchy is
  antisymmetric, in particular acyclic;
* `bot_isSubtype` and `isSubtype_top` — `Bot` and `Top` really are the extremes.
-/

namespace Polymath.OSA4.Audit

open Polymath.OSA4

/-- Depth of a type in the declared hierarchy. -/
def tyRank : Ty → ℕ
  | .Bot => 0
  | .Measurement => 1
  | .Model => 1
  | .Report => 1
  | .Datum => 2
  | .Top => 3

/-- Declared parent edges strictly increase the rank. -/
theorem rank_lt_of_direct {a b : Ty} (h : Ty.direct a b = true) : tyRank a < tyRank b := by
  revert h
  cases a <;> cases b <;> decide

/-- Subtyping never decreases the rank. -/
theorem rank_le_of_isSubtype {a b : Ty} (h : IsSubtype a b) : tyRank a ≤ tyRank b := by
  induction h with
  | refl => exact le_rfl
  | tail _ hbc ih => exact le_trans ih (le_of_lt (rank_lt_of_direct hbc))

/-- The type hierarchy is antisymmetric. -/
theorem isSubtype_antisymm {a b : Ty} (hab : IsSubtype a b) (hba : IsSubtype b a) : a = b := by
  rcases Relation.ReflTransGen.cases_head hab with rfl | ⟨c, hac, hcb⟩
  · rfl
  · exfalso
    have h₁ : tyRank a < tyRank c := rank_lt_of_direct hac
    have h₂ : tyRank c ≤ tyRank b := rank_le_of_isSubtype hcb
    have h₃ : tyRank b ≤ tyRank a := rank_le_of_isSubtype hba
    omega

/-- Nothing climbs down the hierarchy. -/
theorem not_isSubtype_of_rank_lt {a b : Ty} (h : tyRank b < tyRank a) : ¬ IsSubtype a b :=
  fun hs => absurd (rank_le_of_isSubtype hs) (by omega)

theorem not_isSubtype_top_bot : ¬ IsSubtype .Top .Bot :=
  not_isSubtype_of_rank_lt (by decide)

/-- `Bot` is below every type. -/
theorem bot_isSubtype (b : Ty) : IsSubtype .Bot b := by
  cases b with
  | Bot => exact law001_subtype_refl _
  | Measurement => exact subtype_of_direct (by decide)
  | Model => exact subtype_of_direct (by decide)
  | Report => exact subtype_of_direct (by decide)
  | Datum => exact bot_subtype_datum
  | Top =>
      exact law002_subtype_trans (b := Ty.Report) (subtype_of_direct (by decide))
        (subtype_of_direct (by decide))

/-- `Top` is above every type. -/
theorem isSubtype_top (a : Ty) : IsSubtype a .Top := by
  cases a with
  | Bot => exact bot_isSubtype _
  | Measurement => exact measurement_subtype_top
  | Model =>
      exact law002_subtype_trans (b := Ty.Datum) (subtype_of_direct (by decide))
        (subtype_of_direct (by decide))
  | Report => exact subtype_of_direct (by decide)
  | Datum => exact subtype_of_direct (by decide)
  | Top => exact law001_subtype_refl _

/-- The audit of the type system: reflexive, transitive, antisymmetric, bounded. -/
theorem typeSystem_audit :
    (∀ a : Ty, IsSubtype a a) ∧
    (∀ a b c : Ty, IsSubtype a b → IsSubtype b c → IsSubtype a c) ∧
    (∀ a b : Ty, IsSubtype a b → IsSubtype b a → a = b) ∧
    (∀ a : Ty, IsSubtype .Bot a ∧ IsSubtype a .Top) :=
  ⟨law001_subtype_refl, fun _ _ _ h₁ h₂ => law002_subtype_trans h₁ h₂,
   fun _ _ h₁ h₂ => isSubtype_antisymm h₁ h₂, fun a => ⟨bot_isSubtype a, isSubtype_top a⟩⟩

end Polymath.OSA4.Audit
