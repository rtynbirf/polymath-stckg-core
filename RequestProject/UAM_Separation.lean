import RequestProject.UAM_ContextFree
import RequestProject.Bridges.RegularContextFree
import RequestProject.UAM_MyhillNerode

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-!
# Regular languages are a *proper* subclass of the context-free languages

The language `anbn = { aⁿbⁿ }` over the two-letter alphabet `Bool` (with `false`
playing the role of `a` and `true` of `b`) is generated by the grammar
`anbnGrammar` with the two rules `S → ε` and `S → a S b`
(`anbnGrammar_language`), yet it is not regular: the words `aⁿ` are pairwise
inequivalent for the Myhill–Nerode relation, so the relation has infinite index
(`anbn_not_regular`).

Together with `regular_subset_contextFree` this separates the two classes:
`regular_lt_contextFree`.
-/

namespace UAM.Separation

open UAM.ContextFree
open UAM.MyhillNerode

/-! ## The language `aⁿbⁿ` -/

/-- `aⁿbⁿ`, with `false` for `a` and `true` for `b`. -/
def anbn : Set (List Bool) :=
  {w | ∃ n : ℕ, w = List.replicate n false ++ List.replicate n true}

/-- The grammar with rules `S → ε` and `S → a S b`. -/
def anbnGrammar : Grammar Unit Bool where
  rule _ β := β = [] ∨ β = [Sum.inr false, Sum.inl (), Sum.inr true]
  start := ()

theorem yields_anbnGrammar_replicate (n : ℕ) :
    Yields anbnGrammar [Sum.inl ()]
      (List.replicate n false ++ List.replicate n true) := by
  induction n with
  | zero =>
    have := Yields.nonterm (g := anbnGrammar) (A := ()) (Or.inl rfl) Yields.nil Yields.nil
    simpa using this
  | succ n ih =>
    have htail : Yields anbnGrammar [Sum.inl (), Sum.inr true]
        ((List.replicate n false ++ List.replicate n true) ++ [true]) := by
      have h1 : Yields anbnGrammar [Sum.inr true] [true] := Yields.term Yields.nil
      exact Yields.append (α := [Sum.inl ()]) ih h1
    have hβ : Yields anbnGrammar [Sum.inr false, Sum.inl (), Sum.inr true]
        (false :: ((List.replicate n false ++ List.replicate n true) ++ [true])) :=
      Yields.term htail
    have := Yields.nonterm (g := anbnGrammar) (A := ()) (Or.inr rfl) hβ Yields.nil
    rw [List.append_nil] at this
    have hrw : List.replicate (n + 1) false ++ List.replicate (n + 1) true =
        false :: ((List.replicate n false ++ List.replicate n true) ++ [true]) := by
      rw [List.replicate_succ, List.replicate_succ']
      simp
    rw [hrw]
    exact this

theorem anbn_subset_language : anbn ⊆ anbnGrammar.language := by
  rintro w ⟨n, rfl⟩
  exact yields_anbnGrammar_replicate n

theorem yields_anbnGrammar_bounded :
    ∀ (n : ℕ) (w : List Bool), w.length ≤ n → Yields anbnGrammar [Sum.inl ()] w → w ∈ anbn := by
  intro n
  induction n with
  | zero =>
    intro w hlen _
    have : w = [] := List.eq_nil_of_length_eq_zero (Nat.le_zero.1 hlen)
    exact ⟨0, by rw [this]; rfl⟩
  | succ n ih =>
    intro w hlen hw
    obtain ⟨β, hr, hβ⟩ := yields_singleton_inv hw
    rcases hr with rfl | rfl
    · cases hβ
      exact ⟨0, rfl⟩
    · obtain ⟨u, htail, rfl⟩ : ∃ u, Yields anbnGrammar [Sum.inl (), Sum.inr true] u ∧
          w = false :: u := by
        cases hβ with
        | term ht => exact ⟨_, ht, rfl⟩
      obtain ⟨v, z, rfl, hv, hz⟩ := Yields.split (α := [Sum.inl ()]) htail
      have hzv : z = [true] := by
        cases hz with
        | term hnil => rw [hnil.eq_nil_of_nil]
      subst hzv
      have hlt : v.length ≤ n := by
        simp only [List.length_cons, List.length_append] at hlen
        omega
      obtain ⟨m, hm⟩ := ih v hlt hv
      refine ⟨m + 1, ?_⟩
      rw [List.replicate_succ, List.replicate_succ', hm]
      simp

theorem language_subset_anbn : anbnGrammar.language ⊆ anbn := fun w hw =>
  yields_anbnGrammar_bounded w.length w le_rfl hw

/-- The grammar generates exactly `aⁿbⁿ`. -/
theorem anbnGrammar_language : anbnGrammar.language = anbn :=
  Set.Subset.antisymm language_subset_anbn anbn_subset_language

/-- `aⁿbⁿ` is context-free. -/
theorem anbn_contextFree : ∃ (N : Type) (g : Grammar N Bool), g.language = anbn :=
  ⟨Unit, anbnGrammar, anbnGrammar_language⟩

/-! ## `aⁿbⁿ` is not regular -/

theorem mem_anbn_iff (m n : ℕ) :
    (List.replicate m false ++ List.replicate n true) ∈ anbn ↔ m = n := by
  constructor
  · rintro ⟨k, hk⟩
    have hf := congrArg (fun l : List Bool => l.count false) hk
    have ht := congrArg (fun l : List Bool => l.count true) hk
    simp [List.count_append, List.count_replicate] at hf ht
    omega
  · rintro rfl
    exact ⟨m, rfl⟩

/-- Distinct powers of `a` are Myhill–Nerode inequivalent for `aⁿbⁿ`. -/
theorem nerodeClass_replicate_injective :
    Function.Injective fun n : ℕ => nerodeClass anbn (List.replicate n false) := by
  intro m n hmn
  by_contra hne
  have h := (nerodeClass_eq_iff anbn _ _).1 hmn (List.replicate n true)
  have hn : (List.replicate n false ++ List.replicate n true) ∈ anbn :=
    (mem_anbn_iff n n).2 rfl
  have hm : (List.replicate m false ++ List.replicate n true) ∈ anbn := h.2 hn
  exact hne ((mem_anbn_iff m n).1 hm)

/-- `aⁿbⁿ` has infinitely many Nerode classes. -/
theorem anbn_nerodeClasses_infinite : Infinite (NerodeClasses anbn) :=
  Infinite.of_injective _ nerodeClass_replicate_injective

/-- `aⁿbⁿ` is not a regular language. -/
theorem anbn_not_regular : ¬ Language.IsRegular anbn := by
  intro h
  haveI : Finite (NerodeClasses anbn) := (myhill_nerode_finite_iff_regular anbn).2 h
  haveI := anbn_nerodeClasses_infinite
  exact not_finite (NerodeClasses anbn)

/-! ## The separation -/

/-- The regular languages are a *proper* subclass of the context-free ones: every
automaton language is context-free, and `aⁿbⁿ` is context-free but not
regular. -/
theorem regular_lt_contextFree :
    (∀ {σ : Type} (M : DFA Bool σ), ∃ (N : Type) (g : Grammar N Bool), g.language = M.accepts) ∧
    (∃ (N : Type) (g : Grammar N Bool), g.language = anbn) ∧ ¬ Language.IsRegular anbn :=
  ⟨fun M => ⟨_, ofDFA M, dfa_language_eq_grammar_language M⟩, anbn_contextFree, anbn_not_regular⟩

end UAM.Separation
