import RequestProject.MetaLearning

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-!
# Meta-skills

A skill is an endomorphism of the working state; a plan is a list of skill
names, executed left to right.

* `runList` and `runList_append` — execution is a monoid homomorphism from
  concatenation to composition;
* `Reachable` and `reachable_trans` — the reachability preorder generated by a
  library of skills;
* `exists_library_stabilization` — a growing library of skills drawn from a
  finite catalogue eventually stops growing;
* `mastered_of_stabilization` — after stabilization every further acquisition is
  redundant.
-/

namespace PolymathAtlas.Gestalt.MetaSkills

open Polymath.MetaLearning

universe u v

variable {S : Type u} {T : Type v}

/-- Run a list of skills left to right. -/
def runList (interp : T → S → S) : List T → S → S
  | [], s => s
  | t :: rest, s => runList interp rest (interp t s)

@[simp] theorem runList_nil (interp : T → S → S) (s : S) : runList interp [] s = s := rfl

@[simp] theorem runList_cons (interp : T → S → S) (t : T) (rest : List T) (s : S) :
    runList interp (t :: rest) s = runList interp rest (interp t s) := rfl

/-- Executing a concatenation is executing one plan after the other. -/
theorem runList_append (interp : T → S → S) (x y : List T) (s : S) :
    runList interp (x ++ y) s = runList interp y (runList interp x s) := by
  induction x generalizing s with
  | nil => rfl
  | cons t rest ih => simp [ih]

/-- A state is reachable from another when some plan drawn from the library
takes the one to the other. -/
def Reachable (interp : T → S → S) (lib : Finset T) (s s' : S) : Prop :=
  ∃ plan : List T, (∀ t ∈ plan, t ∈ lib) ∧ runList interp plan s = s'

theorem reachable_refl (interp : T → S → S) (lib : Finset T) (s : S) :
    Reachable interp lib s s := ⟨[], by simp, rfl⟩

theorem reachable_trans {interp : T → S → S} {lib : Finset T} {a b c : S}
    (hab : Reachable interp lib a b) (hbc : Reachable interp lib b c) :
    Reachable interp lib a c := by
  obtain ⟨p, hp, rfl⟩ := hab
  obtain ⟨q, hq, rfl⟩ := hbc
  refine ⟨p ++ q, ?_, ?_⟩
  · intro t ht
    rcases List.mem_append.1 ht with h | h
    · exact hp t h
    · exact hq t h
  · exact runList_append interp p q a

/-- A larger library reaches at least as much. -/
theorem reachable_mono {interp : T → S → S} {lib lib' : Finset T} (hsub : lib ⊆ lib')
    {a b : S} (h : Reachable interp lib a b) : Reachable interp lib' a b := by
  obtain ⟨p, hp, rfl⟩ := h
  exact ⟨p, fun t ht => hsub (hp t ht), rfl⟩

/-- A single skill is reachable in one step. -/
theorem reachable_single {interp : T → S → S} {lib : Finset T} {t : T} (ht : t ∈ lib) (s : S) :
    Reachable interp lib s (interp t s) :=
  ⟨[t], by simpa using ht, rfl⟩

/-! ## Acquisition -/

/-- An acquisition process: a growing family of libraries. -/
def Acquires (L : ℕ → Finset T) : Prop := ∀ n, L n ⊆ L (n + 1)

theorem Acquires.mono {L : ℕ → Finset T} (h : Acquires L) {m n : ℕ} (hmn : m ≤ n) :
    L m ⊆ L n := by
  induction n with
  | zero =>
      obtain rfl : m = 0 := Nat.le_zero.1 hmn
      exact subset_rfl
  | succ n ih =>
      rcases Nat.lt_or_ge m (n + 1) with hlt | hge
      · exact (ih (Nat.lt_succ_iff.1 hlt)).trans (h n)
      · obtain rfl : m = n + 1 := le_antisymm hmn hge
        exact subset_rfl

/-- Acquisition from a finite catalogue terminates. -/
theorem exists_library_stabilization [Fintype T] [DecidableEq T] {L : ℕ → Finset T}
    (h : Acquires L) : ∃ N, ∀ m, N ≤ m → L m = L N := by
  have hmono : Monotone (fun n => (L n).card) := fun m n hmn =>
    Finset.card_le_card (h.mono hmn)
  obtain ⟨N, hN⟩ := exists_const_of_monotone_bounded hmono
    (B := Fintype.card T) (fun n => Finset.card_le_univ (L n))
  refine ⟨N, fun m hm => ?_⟩
  exact (Finset.eq_of_subset_of_card_le (h.mono hm) (le_of_eq (hN m hm))).symm

/-- Once the library has stabilized, nothing new is ever acquired, so the set of
reachable states no longer grows. -/
theorem mastered_of_stabilization {interp : T → S → S} {L : ℕ → Finset T} {N : ℕ}
    (hstab : ∀ m, N ≤ m → L m = L N) {m : ℕ} (hm : N ≤ m) {a b : S}
    (h : Reachable interp (L m) a b) : Reachable interp (L N) a b := by
  rwa [hstab m hm] at h

end PolymathAtlas.Gestalt.MetaSkills
