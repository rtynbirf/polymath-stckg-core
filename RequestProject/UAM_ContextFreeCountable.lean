import RequestProject.UAM_ContextFreeFinitary

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-!
# There are only countably many context-free languages

`UAM.ContextFree.isContextFree_trivial` shows that the naive predicate
`IsContextFree` is satisfied by *every* language, because a grammar is allowed
infinitely many productions.  The honest predicate `IsCFL`, which insists that
the production set be finite, is genuinely restrictive, and this module proves
it by a counting argument.

* `UAM.ContextFree.exists_natGrammar_of_isCFL` — every context-free language is
  generated by a grammar whose nonterminals are natural numbers and whose
  productions form a `Finset`.  The finitely many nonterminals that actually
  carry productions are renamed injectively into `ℕ`, and all the others are
  collapsed onto the unused label `0`.
* `UAM.ContextFree.countable_setOf_isCFL` — consequently, over a countable
  alphabet there are only countably many context-free languages.
* `UAM.ContextFree.exists_not_isCFL` — since there are uncountably many
  languages over a two-letter alphabet, some language is not context-free.
-/

namespace UAM.ContextFree

variable {T : Type}

/-! ## Grammars with natural-number nonterminals -/

/-- The grammar over the nonterminal type `ℕ` with start symbol `s` and the
finite production set `R`. -/
def natGrammar (s : ℕ) (R : Finset (ℕ × List (ℕ ⊕ T))) : Grammar ℕ T where
  rule A β := (A, β) ∈ R
  start := s

theorem natGrammar_finitary (s : ℕ) (R : Finset (ℕ × List (ℕ ⊕ T))) :
    (natGrammar s R).Finitary := by
  have hset : (natGrammar s R).rules = (R : Set (ℕ × List (ℕ ⊕ T))) := by
    ext ⟨A, β⟩
    exact Iff.rfl
  rw [Grammar.Finitary, hset]
  exact R.finite_toSet

/-- **Normal form for finitary grammars**: every context-free language is
generated by a grammar with nonterminals in `ℕ` and a finite production set. -/
theorem exists_natGrammar_of_isCFL {L : Language T} (h : IsCFL L) :
    ∃ (s : ℕ) (R : Finset (ℕ × List (ℕ ⊕ T))), (natGrammar s R).language = L := by
  classical
  obtain ⟨N, g, hfin, rfl⟩ := h
  set S : Set N := Prod.fst '' g.rules with hSdef
  have hSfin : S.Finite := hfin.image _
  haveI : Countable ↥S := hSfin.countable.to_subtype
  obtain ⟨ι, hι⟩ := Countable.exists_injective_nat ↥S
  let e : N → ℕ := fun A => if h : A ∈ S then ι ⟨A, h⟩ + 1 else 0
  have he_mem : ∀ (A : N) (hA : A ∈ S), e A = ι ⟨A, hA⟩ + 1 := fun A hA => dif_pos hA
  have he_not : ∀ A : N, A ∉ S → e A = 0 := fun A hA => dif_neg hA
  have heinj : ∀ A B : N, A ∈ S → e A = e B → A = B := by
    intro A B hA hAB
    have hB : B ∈ S := by
      by_contra hB
      rw [he_mem A hA, he_not B hB] at hAB
      exact Nat.succ_ne_zero _ hAB
    rw [he_mem A hA, he_mem B hB] at hAB
    have hιeq : ι ⟨A, hA⟩ = ι ⟨B, hB⟩ := by omega
    exact congrArg Subtype.val (hι hιeq)
  have hRfin :
      (Set.image (fun p : N × List (N ⊕ T) => (e p.1, relabel e p.2)) g.rules).Finite :=
    hfin.image _
  refine ⟨e g.start, hRfin.toFinset, ?_⟩
  have hrel : Relabelling g (natGrammar (e g.start) hRfin.toFinset) e := by
    constructor
    · intro A β hr
      show (e A, relabel e β) ∈ hRfin.toFinset
      rw [Set.Finite.mem_toFinset]
      exact ⟨(A, β), hr, rfl⟩
    · intro A β' hr
      have hr' : (e A, β') ∈ hRfin.toFinset := hr
      rw [Set.Finite.mem_toFinset] at hr'
      obtain ⟨⟨A₀, β₀⟩, hmem, heq⟩ := hr'
      have hA₀ : A₀ ∈ S := ⟨(A₀, β₀), hmem, rfl⟩
      have h1 : e A₀ = e A := congrArg Prod.fst heq
      have h2 : relabel e β₀ = β' := congrArg Prod.snd heq
      have hAA : A₀ = A := heinj A₀ A hA₀ h1
      subst hAA
      exact ⟨β₀, hmem, h2.symm⟩
  ext w
  have hiff := yields_relabel_iff hrel [Sum.inl g.start] w
  simpa [Grammar.language, relabel, natGrammar] using hiff

theorem isCFL_iff_exists_natGrammar (L : Language T) :
    IsCFL L ↔ ∃ (s : ℕ) (R : Finset (ℕ × List (ℕ ⊕ T))), (natGrammar s R).language = L :=
  ⟨exists_natGrammar_of_isCFL,
    fun ⟨s, R, hR⟩ => ⟨ℕ, natGrammar s R, natGrammar_finitary s R, hR⟩⟩

/-! ## Counting -/

/-- **Over a countable alphabet there are only countably many context-free
languages.** -/
theorem countable_setOf_isCFL [Countable T] : {L : Language T | IsCFL L}.Countable := by
  refine Set.Countable.mono ?_
    (Set.countable_range
      (fun p : ℕ × Finset (ℕ × List (ℕ ⊕ T)) => (natGrammar p.1 p.2).language))
  rintro L hL
  obtain ⟨s, R, hR⟩ := exists_natGrammar_of_isCFL hL
  exact ⟨(s, R), hR⟩

open Cardinal in
theorem uncountable_language_fin_two : ¬ Countable (Language (Fin 2)) := by
  intro h
  haveI h' : Countable (Set (List (Fin 2))) := h
  have h1 : (#(Set (List (Fin 2)))) ≤ ℵ₀ := Cardinal.mk_le_aleph0
  have h2 : ℵ₀ ≤ #(List (Fin 2)) := Cardinal.aleph0_le_mk _
  have h3 := Cardinal.cantor (#(List (Fin 2)))
  rw [← Cardinal.mk_set] at h3
  exact absurd (h3.trans_le h1) (not_lt.2 h2)

/-- **Not every language is context-free.**  In contrast with
`isContextFree_trivial`, the finitary notion `IsCFL` is a proper restriction:
there are uncountably many languages over a two-letter alphabet but only
countably many context-free ones. -/
theorem exists_not_isCFL : ∃ L : Language (Fin 2), ¬ IsCFL L := by
  by_contra hcon
  push_neg at hcon
  have huniv : {L : Language (Fin 2) | IsCFL L} = Set.univ :=
    Set.eq_univ_of_forall hcon
  have hc := countable_setOf_isCFL (T := Fin 2)
  rw [huniv] at hc
  exact uncountable_language_fin_two (Set.countable_univ_iff.mp hc)

end UAM.ContextFree
