import RequestProject.UAM_ContextFree
import RequestProject.UAM_MyhillNerode
import Mathlib.Combinatorics.Enumerative.DyckWord

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-!
# The Dyck language is context-free but not regular

The Dyck language of balanced bracket words is generated by the two-rule
grammar `S → ε`, `S → U S D S`.  The first-return decomposition of a Dyck word
(`DyckWord.nest_insidePart_add_outsidePart`) matches the second rule exactly,
which gives both inclusions:

* `UAM.Dyck.dyckGrammar_language` — the grammar generates exactly the Dyck
  language;
* `UAM.Dyck.dyck_contextFree` — the Dyck language is context-free;
* `UAM.Dyck.dyck_not_regular` — it is not regular, because the powers `Uⁿ` are
  pairwise Myhill–Nerode inequivalent;
* `UAM.Dyck.dyck_contextFree_not_regular` — the two facts combined.
-/

namespace UAM.Dyck

open UAM.ContextFree UAM.MyhillNerode DyckStep

/-- The Dyck language: the words underlying Dyck words. -/
def dyckLang : Language DyckStep := {w | ∃ p : DyckWord, p.toList = w}

/-- The two-rule Dyck grammar `S → ε`, `S → U S D S`. -/
def dyckGrammar : Grammar Unit DyckStep where
  rule _ β := β = [] ∨ β = [Sum.inr U, Sum.inl (), Sum.inr D, Sum.inl ()]
  start := ()

/-! ## Every Dyck word is generated -/

theorem yields_nil : Yields dyckGrammar [Sum.inl ()] ([] : List DyckStep) := by
  have := Yields.nonterm (g := dyckGrammar) (A := ()) (Or.inl rfl) Yields.nil Yields.nil
  simpa using this

theorem yields_step {u v : List DyckStep}
    (hu : Yields dyckGrammar [Sum.inl ()] u) (hv : Yields dyckGrammar [Sum.inl ()] v) :
    Yields dyckGrammar [Sum.inl ()] (U :: (u ++ D :: v)) := by
  have htail : Yields dyckGrammar [Sum.inl (), Sum.inr D, Sum.inl ()] (u ++ D :: v) :=
    hu.append (Yields.term hv)
  have hβ : Yields dyckGrammar [Sum.inr U, Sum.inl (), Sum.inr D, Sum.inl ()]
      (U :: (u ++ D :: v)) := Yields.term htail
  have := Yields.nonterm (g := dyckGrammar) (A := ()) (Or.inr rfl) hβ Yields.nil
  simpa using this

theorem yields_of_dyckWord (p : DyckWord) : Yields dyckGrammar [Sum.inl ()] p.toList := by
  have aux : ∀ n : ℕ, ∀ q : DyckWord, q.semilength = n →
      Yields dyckGrammar [Sum.inl ()] q.toList := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro q hq
      by_cases hz : q = 0
      · subst hz
        simpa using yields_nil
      · have hin : Yields dyckGrammar [Sum.inl ()] q.insidePart.toList :=
          ih q.insidePart.semilength (hq ▸ DyckWord.semilength_insidePart_lt hz)
            q.insidePart rfl
        have hout : Yields dyckGrammar [Sum.inl ()] q.outsidePart.toList :=
          ih q.outsidePart.semilength (hq ▸ DyckWord.semilength_outsidePart_lt hz)
            q.outsidePart rfl
        have hdec : q.insidePart.nest + q.outsidePart = q :=
          DyckWord.nest_insidePart_add_outsidePart hz
        have hadd : (q.insidePart.nest + q.outsidePart).toList
            = U :: (q.insidePart.toList ++ D :: q.outsidePart.toList) := by
          show q.insidePart.nest.toList ++ q.outsidePart.toList = _
          simp [DyckWord.nest]
        have hy := yields_step hin hout
        rw [← hadd, hdec] at hy
        exact hy
  exact aux p.semilength p rfl

/-! ## Every generated word is a Dyck word -/

theorem exists_dyckWord_of_yields :
    ∀ w : List DyckStep, Yields dyckGrammar [Sum.inl ()] w → ∃ p : DyckWord, p.toList = w := by
  have aux : ∀ n : ℕ, ∀ w : List DyckStep, w.length = n →
      Yields dyckGrammar [Sum.inl ()] w → ∃ p : DyckWord, p.toList = w := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro w hwn hw
      obtain ⟨β, hrule, hβ⟩ := yields_singleton_inv hw
      rcases hrule with rfl | rfl
      · exact ⟨0, by rw [hβ.eq_nil_of_nil]; rfl⟩
      · -- `w = U :: u ++ D :: v` with `u` and `v` generated
        cases hβ with
        | term htail =>
          rename_i w'
          cases htail with
          | nonterm hr hu hrest =>
            rename_i βu u wrest
            cases hrest with
            | term hrest2 =>
              rename_i w2
              cases hrest2 with
              | nonterm hr2 hv hnil =>
                rename_i βv v w3
                have hw3 : w3 = [] := hnil.eq_nil_of_nil
                subst hw3
                have hu' : Yields dyckGrammar [Sum.inl ()] u := by
                  have := Yields.nonterm (g := dyckGrammar) (A := ()) hr hu Yields.nil
                  simpa using this
                have hv' : Yields dyckGrammar [Sum.inl ()] v := by
                  have := Yields.nonterm (g := dyckGrammar) (A := ()) hr2 hv Yields.nil
                  simpa using this
                have hlenu : u.length < n := by
                  subst hwn; simp
                have hlenv : v.length < n := by
                  subst hwn; simp; omega
                obtain ⟨pu, hpu⟩ := ih u.length hlenu u rfl hu'
                obtain ⟨pv, hpv⟩ := ih v.length hlenv v rfl hv'
                refine ⟨pu.nest + pv, ?_⟩
                show pu.nest.toList ++ pv.toList = _
                simp [DyckWord.nest, hpu, hpv]
  exact fun w hw => aux w.length w rfl hw

/-- **The Dyck grammar generates exactly the Dyck language.** -/
theorem dyckGrammar_language : dyckGrammar.language = dyckLang := by
  ext w
  constructor
  · intro hw
    exact exists_dyckWord_of_yields w hw
  · rintro ⟨p, rfl⟩
    exact yields_of_dyckWord p

/-- The Dyck language is context-free. -/
theorem dyck_contextFree : ∃ (N : Type) (g : Grammar N DyckStep), g.language = dyckLang :=
  ⟨Unit, dyckGrammar, dyckGrammar_language⟩

/-! ## The Dyck language is not regular -/

theorem count_replicate_append (m n : ℕ) (s : DyckStep) :
    ((List.replicate m U ++ List.replicate n D).count s)
      = (if s = U then m else 0) + (if s = D then n else 0) := by
  cases s <;> simp [List.count_append, List.count_replicate]

/-- `Uᵐ Dⁿ` is a Dyck word exactly when `m = n`. -/
theorem mem_dyckLang_iff (m n : ℕ) :
    (List.replicate m U ++ List.replicate n D) ∈ dyckLang ↔ m = n := by
  constructor
  · rintro ⟨p, hp⟩
    have hcount := p.count_U_eq_count_D
    rw [hp, count_replicate_append, count_replicate_append] at hcount
    simpa using hcount
  · rintro rfl
    refine ⟨⟨List.replicate m U ++ List.replicate m D, ?_, ?_⟩, rfl⟩
    · rw [count_replicate_append, count_replicate_append]; simp
    · intro i
      rw [List.take_append]
      simp [List.count_append, List.count_replicate]

/-- Distinct powers of `U` are Myhill–Nerode inequivalent for the Dyck
language. -/
theorem nerodeClass_replicate_injective :
    Function.Injective fun n : ℕ => nerodeClass dyckLang (List.replicate n U) := by
  intro m n hmn
  by_contra hne
  have h := (nerodeClass_eq_iff dyckLang _ _).1 hmn (List.replicate n D)
  have hn : (List.replicate n U ++ List.replicate n D) ∈ dyckLang := (mem_dyckLang_iff n n).2 rfl
  have hm : (List.replicate m U ++ List.replicate n D) ∈ dyckLang := h.2 hn
  exact hne ((mem_dyckLang_iff m n).1 hm)

theorem dyck_nerodeClasses_infinite : Infinite (NerodeClasses dyckLang) :=
  Infinite.of_injective _ nerodeClass_replicate_injective

/-- The Dyck language is not regular. -/
theorem dyck_not_regular : ¬ Language.IsRegular dyckLang := by
  intro h
  haveI : Finite (NerodeClasses dyckLang) := (myhill_nerode_finite_iff_regular dyckLang).2 h
  haveI := dyck_nerodeClasses_infinite
  exact not_finite (NerodeClasses dyckLang)

/-- The Dyck language separates the context-free languages from the regular
ones. -/
theorem dyck_contextFree_not_regular :
    (∃ (N : Type) (g : Grammar N DyckStep), g.language = dyckLang) ∧
      ¬ Language.IsRegular dyckLang :=
  ⟨dyck_contextFree, dyck_not_regular⟩

end UAM.Dyck
