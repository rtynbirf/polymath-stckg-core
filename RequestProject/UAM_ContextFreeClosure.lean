import RequestProject.UAM_ContextFree
import RequestProject.Bridges.RegularContextFree

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-!
# Closure properties of the context-free languages

A language is *context-free* when it is generated by some context-free grammar
(`UAM.ContextFree.IsContextFree`).  This module proves the three Kleene closure
properties of that class:

* `IsContextFree.union` — closure under union;
* `IsContextFree.concat` — closure under concatenation;
* `IsContextFree.star` — closure under Kleene star.

All three constructions relabel the nonterminals of the given grammars into a
common type and add a fresh start symbol.  The technical device that makes the
relabelling transparent is `yields_relabel_iff`: derivations are preserved and
reflected by an injective renaming of nonterminals that matches the rule sets.
-/

namespace UAM.ContextFree

universe u

variable {N N' T : Type u}

/-! ## Relabelling nonterminals -/

/-- Apply a renaming of nonterminals to a sentential form. -/
def relabel (e : N → N') (α : List (N ⊕ T)) : List (N' ⊕ T) :=
  α.map (Sum.map e id)

@[simp] theorem relabel_nil (e : N → N') : relabel (T := T) e [] = [] := rfl

@[simp] theorem relabel_cons (e : N → N') (x : N ⊕ T) (α : List (N ⊕ T)) :
    relabel e (x :: α) = Sum.map e id x :: relabel e α := rfl

@[simp] theorem relabel_append (e : N → N') (α β : List (N ⊕ T)) :
    relabel e (α ++ β) = relabel e α ++ relabel e β := by
  simp [relabel]

/-- A renaming of nonterminals compatible with the two rule sets. -/
structure Relabelling (g : Grammar N T) (g' : Grammar N' T) (e : N → N') : Prop where
  /-- Rules are transported forwards. -/
  forward : ∀ A β, g.rule A β → g'.rule (e A) (relabel e β)
  /-- Every rule of `g'` at a renamed nonterminal comes from a rule of `g`. -/
  backward : ∀ A β', g'.rule (e A) β' → ∃ β, g.rule A β ∧ β' = relabel e β

theorem Relabelling.yields {g : Grammar N T} {g' : Grammar N' T} {e : N → N'}
    (h : Relabelling g g' e) {α : List (N ⊕ T)} {w : List T} (hy : Yields g α w) :
    Yields g' (relabel e α) w := by
  induction hy with
  | nil => exact Yields.nil
  | term _ ih => exact Yields.term ih
  | nonterm hr _ _ ihβ ihtail => exact Yields.nonterm (h.forward _ _ hr) ihβ ihtail

theorem Relabelling.yields_of {g : Grammar N T} {g' : Grammar N' T} {e : N → N'}
    (h : Relabelling g g' e) {α' : List (N' ⊕ T)} {w : List T}
    (hy : Yields g' α' w) : ∀ α : List (N ⊕ T), α' = relabel e α → Yields g α w := by
  induction hy with
  | nil =>
    intro α hα
    cases α with
    | nil => exact Yields.nil
    | cons x t => simp [relabel] at hα
  | @term a α'' w' _ ih =>
    intro α hα
    cases α with
    | nil => simp [relabel] at hα
    | cons x t =>
      cases x with
      | inl A => simp [relabel] at hα
      | inr b =>
        simp only [relabel_cons, Sum.map_inr, id_eq, List.cons.injEq] at hα
        obtain ⟨hb, ht⟩ := hα
        cases (Sum.inr_injective hb.symm : b = a)
        exact Yields.term (ih t ht)
  | @nonterm A' β' α'' u w' hr _ _ ihβ ihtail =>
    intro α hα
    cases α with
    | nil => simp [relabel] at hα
    | cons x t =>
      cases x with
      | inr b => simp [relabel] at hα
      | inl A =>
        simp only [relabel_cons, Sum.map_inl, List.cons.injEq] at hα
        obtain ⟨hA, ht⟩ := hα
        have hA' : e A = A' := (Sum.inl_injective hA).symm
        subst hA'
        obtain ⟨β, hβ, rfl⟩ := h.backward A β' hr
        exact Yields.nonterm hβ (ihβ β rfl) (ihtail t ht)

/-- Derivations are preserved and reflected by a compatible
relabelling of the nonterminals. -/
theorem yields_relabel_iff {g : Grammar N T} {g' : Grammar N' T} {e : N → N'}
    (h : Relabelling g g' e) (α : List (N ⊕ T)) (w : List T) :
    Yields g' (relabel e α) w ↔ Yields g α w :=
  ⟨fun hy => h.yields_of hy α rfl, fun hy => h.yields hy⟩

/-! ## Context-free languages -/

/-- A language is context-free when some grammar generates it. -/
def IsContextFree (L : Language T) : Prop :=
  ∃ (N : Type u) (g : Grammar N T), g.language = L

theorem isContextFree_language (g : Grammar N T) : IsContextFree g.language :=
  ⟨N, g, rfl⟩

/-- The language of a grammar, packaged as an element of `Language T` so that
the Kleene-algebra operations apply to it. -/
def Grammar.lang (g : Grammar N T) : Language T := g.language

@[simp] theorem mem_lang {g : Grammar N T} {w : List T} :
    w ∈ g.lang ↔ Yields g [Sum.inl g.start] w := Iff.rfl

/-! ## Union and concatenation -/

section Binary

variable {N₁ N₂ : Type u}

/-- Left injection of nonterminals into the combined nonterminal type. -/
def inl₂ (A : N₁) : Option (N₁ ⊕ N₂) := some (Sum.inl A)

/-- Right injection of nonterminals into the combined nonterminal type. -/
def inr₂ (B : N₂) : Option (N₁ ⊕ N₂) := some (Sum.inr B)

/-- The grammar generating the union of two languages: a fresh start symbol with
one rule for each of the two old start symbols. -/
def unionGrammar (g₁ : Grammar N₁ T) (g₂ : Grammar N₂ T) : Grammar (Option (N₁ ⊕ N₂)) T where
  rule C γ :=
    match C with
    | none => γ = [Sum.inl (inl₂ (N₂ := N₂) g₁.start)] ∨ γ = [Sum.inl (inr₂ (N₁ := N₁) g₂.start)]
    | some (Sum.inl A) => ∃ β, g₁.rule A β ∧ γ = relabel inl₂ β
    | some (Sum.inr B) => ∃ β, g₂.rule B β ∧ γ = relabel inr₂ β
  start := none

/-- The grammar generating the concatenation of two languages. -/
def concatGrammar (g₁ : Grammar N₁ T) (g₂ : Grammar N₂ T) : Grammar (Option (N₁ ⊕ N₂)) T where
  rule C γ :=
    match C with
    | none => γ = [Sum.inl (inl₂ (N₂ := N₂) g₁.start), Sum.inl (inr₂ (N₁ := N₁) g₂.start)]
    | some (Sum.inl A) => ∃ β, g₁.rule A β ∧ γ = relabel inl₂ β
    | some (Sum.inr B) => ∃ β, g₂.rule B β ∧ γ = relabel inr₂ β
  start := none

theorem relabelling_inl_union (g₁ : Grammar N₁ T) (g₂ : Grammar N₂ T) :
    Relabelling g₁ (unionGrammar g₁ g₂) inl₂ where
  forward := fun _ _ hr => ⟨_, hr, rfl⟩
  backward := fun _ _ hr => hr

theorem relabelling_inr_union (g₁ : Grammar N₁ T) (g₂ : Grammar N₂ T) :
    Relabelling g₂ (unionGrammar g₁ g₂) inr₂ where
  forward := fun _ _ hr => ⟨_, hr, rfl⟩
  backward := fun _ _ hr => hr

theorem relabelling_inl_concat (g₁ : Grammar N₁ T) (g₂ : Grammar N₂ T) :
    Relabelling g₁ (concatGrammar g₁ g₂) inl₂ where
  forward := fun _ _ hr => ⟨_, hr, rfl⟩
  backward := fun _ _ hr => hr

theorem relabelling_inr_concat (g₁ : Grammar N₁ T) (g₂ : Grammar N₂ T) :
    Relabelling g₂ (concatGrammar g₁ g₂) inr₂ where
  forward := fun _ _ hr => ⟨_, hr, rfl⟩
  backward := fun _ _ hr => hr

theorem unionGrammar_language (g₁ : Grammar N₁ T) (g₂ : Grammar N₂ T) :
    (unionGrammar g₁ g₂).language = g₁.language ∪ g₂.language := by
  ext w
  constructor
  · intro hw
    obtain ⟨β, hr, hβ⟩ := yields_singleton_inv hw
    rcases hr with rfl | rfl
    · left
      exact (yields_relabel_iff (relabelling_inl_union g₁ g₂) [Sum.inl g₁.start] w).1 hβ
    · right
      exact (yields_relabel_iff (relabelling_inr_union g₁ g₂) [Sum.inl g₂.start] w).1 hβ
  · rintro (hw | hw)
    · have hβ := (yields_relabel_iff (relabelling_inl_union g₁ g₂) [Sum.inl g₁.start] w).2 hw
      have := Yields.nonterm (g := unionGrammar g₁ g₂) (A := none) (α := [])
        (Or.inl rfl) hβ Yields.nil
      simpa using this
    · have hβ := (yields_relabel_iff (relabelling_inr_union g₁ g₂) [Sum.inl g₂.start] w).2 hw
      have := Yields.nonterm (g := unionGrammar g₁ g₂) (A := none) (α := [])
        (Or.inr rfl) hβ Yields.nil
      simpa using this

theorem concatGrammar_language (g₁ : Grammar N₁ T) (g₂ : Grammar N₂ T) :
    (concatGrammar g₁ g₂).language = {w | ∃ u ∈ g₁.language, ∃ v ∈ g₂.language, w = u ++ v} := by
  ext w
  constructor
  · intro hw
    obtain ⟨β, hr, hβ⟩ := yields_singleton_inv hw
    subst hr
    obtain ⟨u, v, rfl, hu, hv⟩ :=
      Yields.split (α := [Sum.inl (inl₂ (N₂ := N₂) g₁.start)])
        (β := [Sum.inl (inr₂ (N₁ := N₁) g₂.start)]) (by simpa using hβ)
    exact ⟨u, (yields_relabel_iff (relabelling_inl_concat g₁ g₂) [Sum.inl g₁.start] u).1 hu,
      v, (yields_relabel_iff (relabelling_inr_concat g₁ g₂) [Sum.inl g₂.start] v).1 hv, rfl⟩
  · rintro ⟨u, hu, v, hv, rfl⟩
    have h1 := (yields_relabel_iff (relabelling_inl_concat g₁ g₂) [Sum.inl g₁.start] u).2 hu
    have h2 := (yields_relabel_iff (relabelling_inr_concat g₁ g₂) [Sum.inl g₂.start] v).2 hv
    have hcat : Yields (concatGrammar g₁ g₂)
        [Sum.inl (inl₂ (N₂ := N₂) g₁.start), Sum.inl (inr₂ (N₁ := N₁) g₂.start)] (u ++ v) := by
      have := Yields.append (g := concatGrammar g₁ g₂) (by simpa using h1) (by simpa using h2)
      simpa using this
    have := Yields.nonterm (g := concatGrammar g₁ g₂) (A := none) (α := []) rfl hcat Yields.nil
    simpa using this

end Binary

/-! ## Kleene star -/

section Star

open scoped Computability

variable {N : Type u}

theorem append_mem_kstar {L : Language T} {x y : List T} (hx : x ∈ L) (hy : y ∈ L∗) :
    x ++ y ∈ L∗ := by
  obtain ⟨S, rfl, hS⟩ := Language.mem_kstar.1 hy
  refine Language.mem_kstar.2 ⟨x :: S, by simp, ?_⟩
  intro z hz
  rcases List.mem_cons.1 hz with rfl | hz
  · exact hx
  · exact hS z hz

theorem kstar_append_kstar {L : Language T} {x y : List T} (hx : x ∈ L∗) (hy : y ∈ L∗) :
    x ++ y ∈ L∗ := by
  obtain ⟨S, rfl, hS⟩ := Language.mem_kstar.1 hx
  obtain ⟨S', rfl, hS'⟩ := Language.mem_kstar.1 hy
  refine Language.mem_kstar.2 ⟨S ++ S', by simp, ?_⟩
  intro z hz
  rcases List.mem_append.1 hz with hz | hz
  · exact hS z hz
  · exact hS' z hz

/-- The grammar generating the Kleene star of a language: a fresh start symbol
that either stops or produces one factor followed by itself. -/
def starGrammar (g : Grammar N T) : Grammar (Option N) T where
  rule C γ :=
    match C with
    | none => γ = [] ∨ γ = [Sum.inl (some g.start), Sum.inl none]
    | some A => ∃ β, g.rule A β ∧ γ = relabel some β
  start := none

theorem relabelling_star (g : Grammar N T) : Relabelling g (starGrammar g) some where
  forward := fun _ _ hr => ⟨_, hr, rfl⟩
  backward := fun _ _ hr => hr

/-- Analysis of a derivation of the star grammar from a sentential form made of
a relabelled form of the original grammar followed by copies of the fresh start
symbol. -/
theorem starGrammar_yields_analysis (g : Grammar N T) {α : List (Option N ⊕ T)} {w : List T}
    (hy : Yields (starGrammar g) α w) :
    ∀ (γ : List (N ⊕ T)) (k : ℕ), α = relabel some γ ++ List.replicate k (Sum.inl none) →
      ∃ u v, w = u ++ v ∧ Yields g γ u ∧ v ∈ g.lang∗ ∧ (k = 0 → v = []) := by
  induction hy with
  | nil =>
    intro γ k hα
    have hγ : γ = [] := by
      cases γ with
      | nil => rfl
      | cons x t => simp [relabel] at hα
    subst hγ
    have hk : k = 0 := by
      cases k with
      | zero => rfl
      | succ m => simp [relabel, List.replicate_succ] at hα
    subst hk
    exact ⟨[], [], rfl, Yields.nil, Language.nil_mem_kstar _, fun _ => rfl⟩
  | @term a α'' w' _ ih =>
    intro γ k hα
    cases γ with
    | nil =>
      cases k with
      | zero => simp [relabel] at hα
      | succ m => simp [relabel, List.replicate_succ] at hα
    | cons x t =>
      cases x with
      | inl A => simp [relabel] at hα
      | inr b =>
        simp only [relabel_cons, Sum.map_inr, id_eq, List.cons_append, List.cons.injEq] at hα
        obtain ⟨hb, ht⟩ := hα
        cases (Sum.inr_injective hb.symm : b = a)
        obtain ⟨u, v, rfl, hu, hv, hk⟩ := ih t k ht
        exact ⟨a :: u, v, rfl, Yields.term hu, hv, hk⟩
  | @nonterm A' β α'' u' w' hr _ _ ihβ ihtail =>
    intro γ k hα
    cases γ with
    | cons x t =>
      cases x with
      | inr b => simp [relabel] at hα
      | inl A =>
        simp only [relabel_cons, Sum.map_inl, List.cons_append, List.cons.injEq] at hα
        obtain ⟨hA, ht⟩ := hα
        have hA' : some A = A' := (Sum.inl_injective hA).symm
        subst hA'
        obtain ⟨β₀, hβ₀, rfl⟩ := (relabelling_star g).backward A β hr
        obtain ⟨u₁, v₁, hu', hyu₁, -, hk₁⟩ := ihβ β₀ 0 (by simp)
        obtain ⟨u₂, v₂, hw', hyu₂, hv₂, hk₂⟩ := ihtail t k ht
        refine ⟨u₁ ++ u₂, v₂, ?_, Yields.nonterm hβ₀ hyu₁ hyu₂, hv₂, hk₂⟩
        rw [hu', hk₁ rfl, hw']
        simp [List.append_assoc]
    | nil =>
      cases k with
      | zero => simp [relabel] at hα
      | succ m =>
        simp only [relabel_nil, List.nil_append, List.replicate_succ,
          List.cons.injEq] at hα
        obtain ⟨hnone, ht⟩ := hα
        have hA' : (none : Option N) = A' := (Sum.inl_injective hnone).symm
        subst hA'
        rcases hr with rfl | rfl
        · have hu'nil : u' = [] := Yields.eq_nil_of_nil (by assumption)
          obtain ⟨u₂, v₂, hw', hyu₂, hv₂, -⟩ := ihtail [] m ht
          have hu₂ : u₂ = [] := Yields.eq_nil_of_nil hyu₂
          refine ⟨[], w', ?_, Yields.nil, ?_, by simp⟩
          · simp [hu'nil]
          · rw [hw', hu₂]; simpa using hv₂
        · obtain ⟨u₁, v₁, hu', hyu₁, hv₁, -⟩ := ihβ [Sum.inl g.start] 1 (by simp [relabel])
          obtain ⟨u₂, v₂, hw', hyu₂, hv₂, -⟩ := ihtail [] m ht
          have hu₂ : u₂ = [] := Yields.eq_nil_of_nil hyu₂
          refine ⟨[], u' ++ w', by simp, Yields.nil, ?_, by simp⟩
          rw [hu', hw', hu₂]
          simp only [List.nil_append, List.append_assoc]
          exact append_mem_kstar hyu₁ (kstar_append_kstar hv₁ hv₂)

theorem starGrammar_language (g : Grammar N T) :
    (starGrammar g).lang = g.lang∗ := by
  ext w
  constructor
  · intro hw
    obtain ⟨u, v, rfl, hu, hv, -⟩ :=
      starGrammar_yields_analysis g (α := [Sum.inl (none : Option N)]) hw [] 1 (by simp)
    have : u = [] := Yields.eq_nil_of_nil hu
    simpa [this] using hv
  · intro hw
    obtain ⟨S, rfl, hS⟩ := Language.mem_kstar.1 hw
    clear hw
    induction S with
    | nil =>
      have := Yields.nonterm (g := starGrammar g) (A := none) (α := []) (Or.inl rfl)
        Yields.nil Yields.nil
      simpa [Grammar.language] using this
    | cons x S ih =>
      have hx : x ∈ g.language := hS x (by simp)
      have hrest : Yields (starGrammar g) [Sum.inl (none : Option N)] S.flatten :=
        ih (fun z hz => hS z (by simp [hz]))
      have hx' : Yields (starGrammar g) [Sum.inl (some g.start)] x := by
        have := (relabelling_star g).yields (α := [Sum.inl g.start]) hx
        simpa [relabel] using this
      have hcat : Yields (starGrammar g)
          [Sum.inl (some g.start), Sum.inl (none : Option N)] (x ++ S.flatten) := by
        have := Yields.append hx' hrest
        simpa using this
      have := Yields.nonterm (g := starGrammar g) (A := none) (α := []) (Or.inr rfl)
        hcat Yields.nil
      simpa [Grammar.language] using this

end Star

/-! ## Closure properties of the class of context-free languages -/

section Closure

open scoped Computability

/-- The concatenation grammar generates the concatenation of the two
languages. -/
theorem concatGrammar_lang {N₁ N₂ : Type u} (g₁ : Grammar N₁ T) (g₂ : Grammar N₂ T) :
    (concatGrammar g₁ g₂).lang = g₁.lang * g₂.lang := by
  have h := concatGrammar_language g₁ g₂
  ext w
  rw [show ((concatGrammar g₁ g₂).lang : Set (List T)) = (concatGrammar g₁ g₂).language from rfl, h]
  simp only [Language.mem_mul]
  constructor
  · rintro ⟨u, hu, v, hv, rfl⟩; exact ⟨u, hu, v, hv, rfl⟩
  · rintro ⟨u, hu, v, hv, rfl⟩; exact ⟨u, hu, v, hv, rfl⟩

/-- **Context-free languages are closed under union.** -/
theorem IsContextFree.union {L₁ L₂ : Language T}
    (h₁ : IsContextFree L₁) (h₂ : IsContextFree L₂) : IsContextFree (L₁ + L₂) := by
  obtain ⟨N₁, g₁, rfl⟩ := h₁
  obtain ⟨N₂, g₂, rfl⟩ := h₂
  exact ⟨Option (N₁ ⊕ N₂), unionGrammar g₁ g₂, unionGrammar_language g₁ g₂⟩

/-- **Context-free languages are closed under concatenation.** -/
theorem IsContextFree.mul {L₁ L₂ : Language T}
    (h₁ : IsContextFree L₁) (h₂ : IsContextFree L₂) : IsContextFree (L₁ * L₂) := by
  obtain ⟨N₁, g₁, rfl⟩ := h₁
  obtain ⟨N₂, g₂, rfl⟩ := h₂
  exact ⟨Option (N₁ ⊕ N₂), concatGrammar g₁ g₂, concatGrammar_lang g₁ g₂⟩

/-- **Context-free languages are closed under Kleene star.** -/
theorem IsContextFree.kstar {L : Language T} (h : IsContextFree L) : IsContextFree (L∗) := by
  obtain ⟨N, g, rfl⟩ := h
  exact ⟨Option N, starGrammar g, starGrammar_language g⟩

/-- Every regular language is context-free. -/
theorem isContextFree_of_isRegular {L : Language T} (h : L.IsRegular) : IsContextFree L := by
  obtain ⟨σ, -, M, rfl⟩ := h
  refine ⟨ULift.{u} σ, ofDFA (DFA.reindex Equiv.ulift.symm M), ?_⟩
  rw [dfa_language_eq_grammar_language, DFA.accepts_reindex]

/-- The context-free languages contain every regular language and are closed
under the three Kleene operations. -/
theorem contextFree_kleene_closed :
    (∀ L : Language T, L.IsRegular → IsContextFree L) ∧
      (∀ L₁ L₂ : Language T, IsContextFree L₁ → IsContextFree L₂ → IsContextFree (L₁ + L₂)) ∧
      (∀ L₁ L₂ : Language T, IsContextFree L₁ → IsContextFree L₂ → IsContextFree (L₁ * L₂)) ∧
      (∀ L : Language T, IsContextFree L → IsContextFree (L∗)) :=
  ⟨fun _ h => isContextFree_of_isRegular h,
    fun _ _ h₁ h₂ => h₁.union h₂,
    fun _ _ h₁ h₂ => h₁.mul h₂,
    fun _ h => h.kstar⟩

end Closure

/-! ## Reversal -/

section Reverse

/-- Derivability only depends on the rule relation. -/
theorem yields_congr {g g' : Grammar N T}
    (hrule : ∀ A β, g.rule A β ↔ g'.rule A β) {α : List (N ⊕ T)} {w : List T}
    (hy : Yields g α w) : Yields g' α w := by
  induction hy with
  | nil => exact Yields.nil
  | term _ ih => exact Yields.term ih
  | nonterm hr _ _ ihβ ihtail => exact Yields.nonterm ((hrule _ _).1 hr) ihβ ihtail

/-- The grammar with every rule body reversed. -/
def revGrammar (g : Grammar N T) : Grammar N T where
  rule A β' := ∃ β, g.rule A β ∧ β' = β.reverse
  start := g.start

theorem yields_revGrammar {g : Grammar N T} {α : List (N ⊕ T)} {w : List T}
    (hy : Yields g α w) : Yields (revGrammar g) α.reverse w.reverse := by
  induction hy with
  | nil => exact Yields.nil
  | @term a α₀ w₀ _ ih =>
    have := Yields.append ih (Yields.term (g := revGrammar g) (a := a) Yields.nil)
    simpa using this
  | @nonterm A β α₀ u w₀ hr _ _ ihβ ihtail =>
    have hhead : Yields (revGrammar g) [Sum.inl A] u.reverse := by
      have := Yields.nonterm (g := revGrammar g) (A := A) (α := []) ⟨β, hr, rfl⟩ ihβ Yields.nil
      simpa using this
    have := Yields.append ihtail hhead
    simpa using this

/-- Reversing twice returns the original grammar's rules. -/
theorem rule_revGrammar_revGrammar (g : Grammar N T) (A : N) (β : List (N ⊕ T)) :
    (revGrammar (revGrammar g)).rule A β ↔ g.rule A β := by
  constructor
  · rintro ⟨β', ⟨β'', hβ'', rfl⟩, rfl⟩
    simpa using hβ''
  · intro hβ
    exact ⟨β.reverse, ⟨β, hβ, rfl⟩, by simp⟩

theorem yields_revGrammar_iff {g : Grammar N T} (α : List (N ⊕ T)) (w : List T) :
    Yields (revGrammar g) α.reverse w.reverse ↔ Yields g α w := by
  refine ⟨fun h => ?_, yields_revGrammar⟩
  have h2 := yields_revGrammar h
  rw [List.reverse_reverse, List.reverse_reverse] at h2
  exact yields_congr (g := revGrammar (revGrammar g)) (g' := g)
    (fun A β => rule_revGrammar_revGrammar g A β) h2

/-- The reversed grammar generates the reversed language. -/
theorem revGrammar_language (g : Grammar N T) :
    (revGrammar g).language = {w : List T | w.reverse ∈ g.language} := by
  ext w
  constructor
  · intro hw
    have : Yields (revGrammar g) ([Sum.inl g.start] : List (N ⊕ T)).reverse w.reverse.reverse := by
      simpa using hw
    exact (yields_revGrammar_iff [Sum.inl g.start] w.reverse).1 this
  · intro hw
    have := yields_revGrammar (g := g) (α := [Sum.inl g.start]) hw
    simpa [Grammar.language] using this

/-- **Context-free languages are closed under reversal.** -/
theorem IsContextFree.reverse {L : Language T} (h : IsContextFree L) :
    IsContextFree L.reverse := by
  obtain ⟨N, g, rfl⟩ := h
  exact ⟨N, revGrammar g, revGrammar_language g⟩

end Reverse

end UAM.ContextFree
