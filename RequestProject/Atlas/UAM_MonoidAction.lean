import RequestProject.Atlas.UAM_Free

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-!
# Words acting on the states of an automaton

Reading a word in a deterministic automaton is a monoid action of the free
monoid of words on the state set.  This module records the action laws, the
orbit of a state (which for the initial state is exactly reachability), and the
*transition monoid*: the submonoid of `Function.End σ` generated by the letters.

* `UAM.MonoidAction.act_append` — the action law;
* `UAM.MonoidAction.mem_orbit_act` — orbits are closed under the action;
* `UAM.MonoidAction.transitionMonoid` — the transition monoid of an automaton;
* `UAM.MonoidAction.wordMap_mem_transitionMonoid` — every word acts through it;
* `UAM.MonoidAction.accepts_congr_of_wordMap_eq` — words with the same action
  are indistinguishable by the automaton, hence Nerode-equivalent;
* `UAM.MonoidAction.finite_transitionMonoid` — the transition monoid of a
  finite automaton is finite.
-/

namespace UAM.MonoidAction

universe u v

variable {α : Type u} {σ : Type v}

/-- Reading a word from a state. -/
def act (M : DFA α σ) (q : σ) (w : List α) : σ := M.evalFrom q w

@[simp] theorem act_nil (M : DFA α σ) (q : σ) : act M q [] = q := rfl

@[simp] theorem act_singleton (M : DFA α σ) (q : σ) (a : α) : act M q [a] = M.step q a := rfl

/-- The action law: reading a concatenation is reading the parts in order. -/
theorem act_append (M : DFA α σ) (q : σ) (u v : List α) :
    act M q (u ++ v) = act M (act M q u) v := by
  simp [act, DFA.evalFrom_of_append]

theorem act_cons (M : DFA α σ) (q : σ) (a : α) (w : List α) :
    act M q (a :: w) = act M (M.step q a) w := rfl

theorem eval_eq_act (M : DFA α σ) (w : List α) : M.eval w = act M M.start w := rfl

/-! ## Orbits -/

/-- The set of states reachable from `q` by reading some word. -/
def Orbit (M : DFA α σ) (q : σ) : Set σ := {p | ∃ w : List α, act M q w = p}

theorem mem_orbit_self (M : DFA α σ) (q : σ) : q ∈ Orbit M q := ⟨[], rfl⟩

theorem mem_orbit_act (M : DFA α σ) (q : σ) (w : List α) : act M q w ∈ Orbit M q := ⟨w, rfl⟩

/-- Orbits are closed under the action. -/
theorem orbit_closed {M : DFA α σ} {q p : σ} (hp : p ∈ Orbit M q) (w : List α) :
    act M p w ∈ Orbit M q := by
  obtain ⟨u, rfl⟩ := hp
  exact ⟨u ++ w, by rw [act_append]⟩

/-- Orbits are transitive: the orbit of a point of an orbit is contained in it. -/
theorem orbit_subset_of_mem {M : DFA α σ} {q p : σ} (hp : p ∈ Orbit M q) :
    Orbit M p ⊆ Orbit M q := by
  rintro r ⟨w, rfl⟩
  exact orbit_closed hp w

/-! ## The transition monoid -/

/-- The map induced on states by reading a word, as an endomorphism of the state set. -/
def wordMap (M : DFA α σ) (w : List α) : Function.End σ := fun q => act M q w

@[simp] theorem wordMap_nil (M : DFA α σ) : wordMap M [] = (1 : Function.End σ) := rfl

theorem wordMap_apply (M : DFA α σ) (w : List α) (q : σ) : wordMap M w q = act M q w := rfl

/-- Concatenation of words corresponds to composition of transitions.  Since the
multiplication of `Function.End σ` is composition, reading `u` and then `v`
multiplies in the opposite order. -/
theorem wordMap_append (M : DFA α σ) (u v : List α) :
    wordMap M (u ++ v) = wordMap M v * wordMap M u := by
  funext q
  simp [wordMap, act_append, Function.End.mul_def]

/-- The endomorphism induced by a single letter. -/
def letterMap (M : DFA α σ) (a : α) : Function.End σ := fun q => M.step q a

@[simp] theorem letterMap_apply (M : DFA α σ) (a : α) (q : σ) : letterMap M a q = M.step q a := rfl

@[simp] theorem wordMap_singleton (M : DFA α σ) (a : α) : wordMap M [a] = letterMap M a := rfl

/-- The transition monoid: the submonoid of endomorphisms generated by the letters. -/
def transitionMonoid (M : DFA α σ) : Submonoid (Function.End σ) :=
  Submonoid.closure (Set.range (letterMap M))

theorem letter_mem_transitionMonoid (M : DFA α σ) (a : α) :
    letterMap M a ∈ transitionMonoid M :=
  Submonoid.subset_closure ⟨a, rfl⟩

/-- Every word acts through the transition monoid. -/
theorem wordMap_mem_transitionMonoid (M : DFA α σ) (w : List α) :
    wordMap M w ∈ transitionMonoid M := by
  induction w with
  | nil => simp
  | cons a w ih =>
    have hsplit : wordMap M (a :: w) = wordMap M w * letterMap M a := by
      have := wordMap_append M [a] w
      simpa using this
    rw [hsplit]
    exact (transitionMonoid M).mul_mem ih (letter_mem_transitionMonoid M a)

/-- Conversely, every element of the transition monoid is realised by a word. -/
theorem exists_word_of_mem_transitionMonoid (M : DFA α σ) {f : Function.End σ}
    (hf : f ∈ transitionMonoid M) : ∃ w : List α, wordMap M w = f := by
  induction hf using Submonoid.closure_induction with
  | mem x hx =>
    obtain ⟨a, rfl⟩ := hx
    exact ⟨[a], rfl⟩
  | one => exact ⟨[], rfl⟩
  | mul x y _ _ hx hy =>
    obtain ⟨u, rfl⟩ := hx
    obtain ⟨v, rfl⟩ := hy
    exact ⟨v ++ u, wordMap_append M v u⟩

/-- The transition monoid is exactly the set of maps realised by words. -/
theorem mem_transitionMonoid_iff (M : DFA α σ) (f : Function.End σ) :
    f ∈ transitionMonoid M ↔ ∃ w : List α, wordMap M w = f :=
  ⟨exists_word_of_mem_transitionMonoid M, by
    rintro ⟨w, rfl⟩; exact wordMap_mem_transitionMonoid M w⟩

/-- Words with the same transition map are indistinguishable by the automaton. -/
theorem accepts_congr_of_wordMap_eq {M : DFA α σ} {x y : List α}
    (h : wordMap M x = wordMap M y) (z : List α) :
    (x ++ z ∈ M.accepts) ↔ (y ++ z ∈ M.accepts) := by
  have hx : M.eval (x ++ z) = act M (wordMap M x M.start) z := by
    rw [eval_eq_act, act_append]; rfl
  have hy : M.eval (y ++ z) = act M (wordMap M y M.start) z := by
    rw [eval_eq_act, act_append]; rfl
  simp only [DFA.mem_accepts, hx, hy, h]

/-- The transition monoid of a finite automaton is finite. -/
theorem finite_transitionMonoid (M : DFA α σ) [Finite σ] :
    Finite (transitionMonoid M) := by
  have : Finite (Function.End σ) := by
    unfold Function.End
    infer_instance
  exact Subtype.finite

end UAM.MonoidAction
