import Mathlib

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-!
# Green's relations on a monoid

Green's relations organise a monoid by principal ideals:

* `LLe x y` — `x ∈ M y`, and `LEquiv` is the induced equivalence;
* `RLe x y` — `x ∈ y M`, with `REquiv`;
* `JLe x y` — `x ∈ M y M`, with `JEquiv`;
* `HEquiv := LEquiv ⊓ REquiv` and `DEquiv := LEquiv ∘ REquiv`.

The substantial result here is *Green's commutation lemma*
(`exists_of_LEquiv_REquiv`, `exists_of_REquiv_LEquiv`): the relations `LEquiv`
and `REquiv` commute as relations.  Consequently `DEquiv` is an equivalence
relation (`dEquiv_symm`, `dEquiv_trans`) and is symmetric in the order of the
two factors (`dEquiv_iff_comm`).
-/

namespace UAM.Green

variable {M : Type*} [Monoid M]

/-! ## The three preorders -/

/-- `x ≤L y`: `x` lies in the left ideal generated by `y`. -/
def LLe (x y : M) : Prop := ∃ u : M, x = u * y

/-- `x ≤R y`: `x` lies in the right ideal generated by `y`. -/
def RLe (x y : M) : Prop := ∃ u : M, x = y * u

/-- `x ≤J y`: `x` lies in the two-sided ideal generated by `y`. -/
def JLe (x y : M) : Prop := ∃ u v : M, x = u * y * v

theorem lLe_refl (x : M) : LLe x x := ⟨1, (one_mul x).symm⟩
theorem rLe_refl (x : M) : RLe x x := ⟨1, (mul_one x).symm⟩
theorem jLe_refl (x : M) : JLe x x := ⟨1, 1, by simp⟩

theorem lLe_trans {x y z : M} (h₁ : LLe x y) (h₂ : LLe y z) : LLe x z := by
  obtain ⟨u, rfl⟩ := h₁
  obtain ⟨v, rfl⟩ := h₂
  exact ⟨u * v, (mul_assoc u v z).symm⟩

theorem rLe_trans {x y z : M} (h₁ : RLe x y) (h₂ : RLe y z) : RLe x z := by
  obtain ⟨u, rfl⟩ := h₁
  obtain ⟨v, rfl⟩ := h₂
  exact ⟨v * u, mul_assoc z v u⟩

theorem jLe_trans {x y z : M} (h₁ : JLe x y) (h₂ : JLe y z) : JLe x z := by
  obtain ⟨u, v, rfl⟩ := h₁
  obtain ⟨p, q, rfl⟩ := h₂
  exact ⟨u * p, q * v, by simp [mul_assoc]⟩

theorem jLe_of_lLe {x y : M} (h : LLe x y) : JLe x y := by
  obtain ⟨u, rfl⟩ := h
  exact ⟨u, 1, by simp⟩

theorem jLe_of_rLe {x y : M} (h : RLe x y) : JLe x y := by
  obtain ⟨u, rfl⟩ := h
  exact ⟨1, u, by simp⟩

/-! ## The equivalences -/

/-- Green's `L`-relation. -/
def LEquiv (x y : M) : Prop := LLe x y ∧ LLe y x

/-- Green's `R`-relation. -/
def REquiv (x y : M) : Prop := RLe x y ∧ RLe y x

/-- Green's `J`-relation. -/
def JEquiv (x y : M) : Prop := JLe x y ∧ JLe y x

/-- Green's `H`-relation: the intersection of `L` and `R`. -/
def HEquiv (x y : M) : Prop := LEquiv x y ∧ REquiv x y

/-- Green's `D`-relation: `L` followed by `R`. -/
def DEquiv (x y : M) : Prop := ∃ z : M, LEquiv x z ∧ REquiv z y

theorem lEquiv_refl (x : M) : LEquiv x x := ⟨lLe_refl x, lLe_refl x⟩
theorem lEquiv_symm {x y : M} (h : LEquiv x y) : LEquiv y x := ⟨h.2, h.1⟩
theorem lEquiv_trans {x y z : M} (h₁ : LEquiv x y) (h₂ : LEquiv y z) : LEquiv x z :=
  ⟨lLe_trans h₁.1 h₂.1, lLe_trans h₂.2 h₁.2⟩

theorem rEquiv_refl (x : M) : REquiv x x := ⟨rLe_refl x, rLe_refl x⟩
theorem rEquiv_symm {x y : M} (h : REquiv x y) : REquiv y x := ⟨h.2, h.1⟩
theorem rEquiv_trans {x y z : M} (h₁ : REquiv x y) (h₂ : REquiv y z) : REquiv x z :=
  ⟨rLe_trans h₁.1 h₂.1, rLe_trans h₂.2 h₁.2⟩

theorem jEquiv_refl (x : M) : JEquiv x x := ⟨jLe_refl x, jLe_refl x⟩
theorem jEquiv_symm {x y : M} (h : JEquiv x y) : JEquiv y x := ⟨h.2, h.1⟩
theorem jEquiv_trans {x y z : M} (h₁ : JEquiv x y) (h₂ : JEquiv y z) : JEquiv x z :=
  ⟨jLe_trans h₁.1 h₂.1, jLe_trans h₂.2 h₁.2⟩

theorem hEquiv_refl (x : M) : HEquiv x x := ⟨lEquiv_refl x, rEquiv_refl x⟩
theorem hEquiv_symm {x y : M} (h : HEquiv x y) : HEquiv y x :=
  ⟨lEquiv_symm h.1, rEquiv_symm h.2⟩
theorem hEquiv_trans {x y z : M} (h₁ : HEquiv x y) (h₂ : HEquiv y z) : HEquiv x z :=
  ⟨lEquiv_trans h₁.1 h₂.1, rEquiv_trans h₁.2 h₂.2⟩

theorem jEquiv_of_lEquiv {x y : M} (h : LEquiv x y) : JEquiv x y :=
  ⟨jLe_of_lLe h.1, jLe_of_lLe h.2⟩

theorem jEquiv_of_rEquiv {x y : M} (h : REquiv x y) : JEquiv x y :=
  ⟨jLe_of_rLe h.1, jLe_of_rLe h.2⟩

/-! ## Green's commutation lemma -/

/-- **Green's commutation lemma** (one direction): `L` followed by `R` can be
rewritten as `R` followed by `L`. -/
theorem exists_of_LEquiv_REquiv {x z y : M} (h₁ : LEquiv x z) (h₂ : REquiv z y) :
    ∃ w : M, REquiv x w ∧ LEquiv w y := by
  obtain ⟨⟨u, hxu⟩, ⟨u', hzu⟩⟩ := h₁
  obtain ⟨⟨v, hzv⟩, ⟨v', hyv⟩⟩ := h₂
  have h1 : x = u * y * v := by rw [mul_assoc, ← hzv, ← hxu]
  have h2 : u * y = x * v' := by rw [hxu, mul_assoc, ← hyv]
  have h3 : y = u' * (u * y) := by rw [h2, ← mul_assoc, ← hzu, ← hyv]
  exact ⟨u * y, ⟨⟨v, h1⟩, ⟨v', h2⟩⟩, ⟨u, rfl⟩, ⟨u', h3⟩⟩

/-- **Green's commutation lemma** (other direction). -/
theorem exists_of_REquiv_LEquiv {x z y : M} (h₁ : REquiv x z) (h₂ : LEquiv z y) :
    ∃ w : M, LEquiv x w ∧ REquiv w y := by
  obtain ⟨⟨u, hxu⟩, ⟨u', hzu⟩⟩ := h₁
  obtain ⟨⟨v, hzv⟩, ⟨v', hyv⟩⟩ := h₂
  have h1 : x = v * (y * u) := by rw [← mul_assoc, ← hzv, ← hxu]
  have h2 : y * u = v' * x := by rw [hxu, ← mul_assoc, ← hyv]
  have h3 : y = y * u * u' := by rw [h2, mul_assoc, ← hzu, ← hyv]
  exact ⟨y * u, ⟨⟨v, h1⟩, ⟨v', h2⟩⟩, ⟨u, rfl⟩, ⟨u', h3⟩⟩

/-! ## `D` is an equivalence relation -/

theorem dEquiv_refl (x : M) : DEquiv x x := ⟨x, lEquiv_refl x, rEquiv_refl x⟩

theorem dEquiv_symm {x y : M} (h : DEquiv x y) : DEquiv y x := by
  obtain ⟨z, hxz, hzy⟩ := h
  obtain ⟨w, hyw, hwx⟩ := exists_of_REquiv_LEquiv (rEquiv_symm hzy) (lEquiv_symm hxz)
  exact ⟨w, hyw, hwx⟩

theorem dEquiv_trans {x y w : M} (h₁ : DEquiv x y) (h₂ : DEquiv y w) : DEquiv x w := by
  obtain ⟨z₁, hxz₁, hz₁y⟩ := h₁
  obtain ⟨z₂, hyz₂, hz₂w⟩ := h₂
  obtain ⟨p, hz₁p, hpz₂⟩ := exists_of_REquiv_LEquiv hz₁y hyz₂
  exact ⟨p, lEquiv_trans hxz₁ hz₁p, rEquiv_trans hpz₂ hz₂w⟩

/-- `D` may equally be computed as `R` followed by `L`. -/
theorem dEquiv_iff_comm (x y : M) :
    DEquiv x y ↔ ∃ z : M, REquiv x z ∧ LEquiv z y := by
  constructor
  · rintro ⟨z, hxz, hzy⟩
    exact exists_of_LEquiv_REquiv hxz hzy
  · rintro ⟨z, hxz, hzy⟩
    obtain ⟨w, hxw, hwy⟩ := exists_of_REquiv_LEquiv hxz hzy
    exact ⟨w, hxw, hwy⟩

/-! ## Inclusions between the relations -/

theorem dEquiv_of_lEquiv {x y : M} (h : LEquiv x y) : DEquiv x y :=
  ⟨y, h, rEquiv_refl y⟩

theorem dEquiv_of_rEquiv {x y : M} (h : REquiv x y) : DEquiv x y :=
  ⟨x, lEquiv_refl x, h⟩

theorem dEquiv_of_hEquiv {x y : M} (h : HEquiv x y) : DEquiv x y :=
  dEquiv_of_lEquiv h.1

/-- `D` refines `J`. -/
theorem jEquiv_of_dEquiv {x y : M} (h : DEquiv x y) : JEquiv x y := by
  obtain ⟨z, hxz, hzy⟩ := h
  exact jEquiv_trans (jEquiv_of_lEquiv hxz) (jEquiv_of_rEquiv hzy)

end UAM.Green
