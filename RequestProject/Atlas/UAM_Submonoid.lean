import Mathlib

set_option autoImplicit false
set_option relaxedAutoImplicit false

open scoped Computability

/-!
# Star-closed languages and generated submonoids

A language is *star-closed* when it contains the empty word and is closed under
concatenation, i.e. when it is (the carrier of) a submonoid of the free monoid.
The Kleene star of a language is exactly the star closure:

* `UAM.Submonoid.IsStarClosed` — the closure property;
* `UAM.Submonoid.kstar_isStarClosed` — `L∗` is star-closed;
* `UAM.Submonoid.kstar_le_of_isStarClosed` — `L∗` is the *least* star-closed
  language containing `L`;
* `UAM.Submonoid.kstar_kstar` — idempotence of the star;
* `UAM.Submonoid.kstar_eq_self_iff` — `L∗ = L` exactly for star-closed `L`;
* `UAM.Submonoid.mem_kstar_iff_mem_closure` — `L∗` is the submonoid of the free
  monoid generated by `L`.
-/

namespace UAM.Submonoid

universe u

variable {α : Type u}

/-- A language is star-closed when it is a submonoid of the free monoid: it
contains the empty word and is closed under concatenation. -/
def IsStarClosed (S : Language α) : Prop :=
  [] ∈ S ∧ ∀ x ∈ S, ∀ y ∈ S, x ++ y ∈ S

theorem isStarClosed_univ : IsStarClosed (Set.univ : Language α) :=
  ⟨trivial, fun _ _ _ _ => trivial⟩

theorem mem_kstar_nil (L : Language α) : [] ∈ L∗ :=
  Language.mem_kstar.2 ⟨[], by simp, by simp⟩

theorem mem_kstar_of_mem {L : Language α} {x : List α} (hx : x ∈ L) : x ∈ L∗ :=
  Language.mem_kstar.2 ⟨[x], by simp, by simpa using hx⟩

theorem subset_kstar (L : Language α) : ∀ x ∈ L, x ∈ L∗ := fun _ hx => mem_kstar_of_mem hx

theorem mem_kstar_append {L : Language α} {x y : List α}
    (hx : x ∈ L∗) (hy : y ∈ L∗) : x ++ y ∈ L∗ := by
  obtain ⟨xs, rfl, hxs⟩ := Language.mem_kstar.1 hx
  obtain ⟨ys, rfl, hys⟩ := Language.mem_kstar.1 hy
  refine Language.mem_kstar.2 ⟨xs ++ ys, by simp, ?_⟩
  intro z hz
  rcases List.mem_append.1 hz with h | h
  · exact hxs z h
  · exact hys z h

/-- The Kleene star of a language is star-closed. -/
theorem kstar_isStarClosed (L : Language α) : IsStarClosed L∗ :=
  ⟨mem_kstar_nil L, fun _ hx _ hy => mem_kstar_append hx hy⟩

/-- Every flattening of words drawn from a star-closed language stays inside it. -/
theorem flatten_mem_of_isStarClosed {S : Language α} (hS : IsStarClosed S) :
    ∀ ws : List (List α), (∀ w ∈ ws, w ∈ S) → ws.flatten ∈ S := by
  intro ws
  induction ws with
  | nil => intro _; simpa using hS.1
  | cons w ws ih =>
    intro h
    have hw : w ∈ S := h w (by simp)
    have hws : ws.flatten ∈ S := ih fun x hx => h x (by simp [hx])
    simpa using hS.2 w hw ws.flatten hws

/-- `L∗` is the least star-closed language containing `L`. -/
theorem kstar_le_of_isStarClosed {L S : Language α} (hS : IsStarClosed S)
    (hLS : ∀ x ∈ L, x ∈ S) : ∀ x ∈ L∗, x ∈ S := by
  intro x hx
  obtain ⟨ws, rfl, hws⟩ := Language.mem_kstar.1 hx
  exact flatten_mem_of_isStarClosed hS ws fun w hw => hLS w (hws w hw)

theorem kstar_mono {L M : Language α} (h : ∀ x ∈ L, x ∈ M) : ∀ x ∈ L∗, x ∈ M∗ := by
  intro x hx
  exact kstar_le_of_isStarClosed (L := L) (S := M∗) (kstar_isStarClosed M)
    (fun y hy => mem_kstar_of_mem (h y hy)) x hx

/-- A star-closed language is its own star. -/
theorem kstar_eq_self_of_isStarClosed {S : Language α} (hS : IsStarClosed S) : S∗ = S := by
  ext x
  exact ⟨fun hx => kstar_le_of_isStarClosed hS (fun _ h => h) x hx, fun hx => mem_kstar_of_mem hx⟩

theorem kstar_eq_self_iff (S : Language α) : S∗ = S ↔ IsStarClosed S := by
  constructor
  · intro h; rw [← h]; exact kstar_isStarClosed S
  · exact kstar_eq_self_of_isStarClosed

/-- The Kleene star is idempotent. -/
theorem kstar_kstar (L : Language α) : (L∗)∗ = L∗ :=
  kstar_eq_self_of_isStarClosed (kstar_isStarClosed L)

theorem kstar_zero : (0 : Language α)∗ = 1 := by
  ext x
  constructor
  · intro hx
    obtain ⟨ws, rfl, hws⟩ := Language.mem_kstar.1 hx
    have hnil : ws = [] := by
      cases ws with
      | nil => rfl
      | cons w ws =>
        have hw := hws w (by simp)
        rw [Language.zero_def] at hw
        exact absurd hw (Set.notMem_empty w)
    rw [Language.mem_one, hnil]
    simp
  · intro hx
    have hx' : x = [] := (Language.mem_one x).1 hx
    rw [hx']
    exact mem_kstar_nil (0 : Language α)

theorem kstar_one : (1 : Language α)∗ = 1 :=
  kstar_eq_self_of_isStarClosed
    ⟨Language.nil_mem_one, by
      intro x hx y hy
      have hx' : x = [] := (Language.mem_one x).1 hx
      have hy' : y = [] := (Language.mem_one y).1 hy
      rw [Language.mem_one, hx', hy']
      simp⟩

/-! ## Relation with the submonoid generated inside the free monoid -/

/-- The submonoid of the free monoid generated by a language. -/
def generated (L : Language α) : _root_.Submonoid (FreeMonoid α) :=
  _root_.Submonoid.closure (FreeMonoid.ofList '' L)

theorem toList_mul (x y : FreeMonoid α) :
    FreeMonoid.toList (x * y) = FreeMonoid.toList x ++ FreeMonoid.toList y := rfl

/-- A word lies in the Kleene star exactly when it lies in the generated submonoid. -/
theorem mem_kstar_iff_mem_closure (L : Language α) (x : List α) :
    x ∈ L∗ ↔ FreeMonoid.ofList x ∈ generated L := by
  constructor
  · intro hx
    obtain ⟨ws, rfl, hws⟩ := Language.mem_kstar.1 hx
    clear hx
    induction ws with
    | nil => simp
    | cons w ws ih =>
      have hw : FreeMonoid.ofList w ∈ generated L :=
        _root_.Submonoid.subset_closure ⟨w, hws w (by simp), rfl⟩
      have hrest : FreeMonoid.ofList ws.flatten ∈ generated L :=
        ih fun z hz => hws z (by simp [hz])
      have : FreeMonoid.ofList ((w :: ws).flatten)
          = FreeMonoid.ofList w * FreeMonoid.ofList ws.flatten := by
        rfl
      rw [this]
      exact (generated L).mul_mem hw hrest
  · intro hx
    have key : ∀ y : FreeMonoid α, y ∈ generated L → FreeMonoid.toList y ∈ L∗ := by
      intro y hy
      induction hy using _root_.Submonoid.closure_induction with
      | mem z hz =>
        obtain ⟨w, hw, rfl⟩ := hz
        exact mem_kstar_of_mem (by simpa using hw)
      | one => simpa using mem_kstar_nil L
      | mul a b _ _ ha hb => exact mem_kstar_append ha hb
    simpa using key _ hx

end UAM.Submonoid
