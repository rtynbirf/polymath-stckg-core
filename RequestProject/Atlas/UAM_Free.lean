import Mathlib

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-!
# The free monoid of words

Words over an alphabet `α` are lists, and concatenation makes them the free
monoid on `α`.  This module records the evaluation map `eval f` extending a
letter assignment `f : α → M` to words, together with the universal property:
`eval f` is the *unique* function on words that is multiplicative, sends the
empty word to `1`, and agrees with `f` on single letters
(`eval_unique`, `exists_unique_wordExtension`).

These are the basic tools used by the recognizability layer
(`UAM.Morphism`) and by the syntactic-monoid layer (`UAM.Syntactic`).
-/

namespace UAM.Free

universe u v w

variable {α : Type u} {M : Type v} [Monoid M]

/-- Evaluate a word in a monoid: map every letter and take the product. -/
def eval (f : α → M) (x : List α) : M := (x.map f).prod

@[simp] theorem eval_nil (f : α → M) : eval f [] = 1 := rfl

@[simp] theorem eval_cons (f : α → M) (a : α) (x : List α) :
    eval f (a :: x) = f a * eval f x := rfl

@[simp] theorem eval_singleton (f : α → M) (a : α) : eval f [a] = f a := by
  simp [eval]

@[simp] theorem eval_append (f : α → M) (x y : List α) :
    eval f (x ++ y) = eval f x * eval f y := by
  simp [eval]

/-- A word-multiplicative map is determined by its values on letters. -/
theorem eval_unique (f : α → M) (g : List α → M) (hnil : g [] = 1)
    (hmul : ∀ x y, g (x ++ y) = g x * g y) (hgen : ∀ a, g [a] = f a) :
    g = eval f := by
  funext x
  induction x with
  | nil => simpa using hnil
  | cons a t ih =>
    have h := hmul [a] t
    simp only [List.singleton_append] at h
    rw [h, hgen, ih, eval_cons]

/-- **Universal property of the free monoid.**  Every assignment of monoid
elements to letters extends uniquely to a multiplicative map on words. -/
theorem exists_unique_wordExtension (f : α → M) :
    ∃! g : List α → M,
      g [] = 1 ∧ (∀ x y, g (x ++ y) = g x * g y) ∧ (∀ a, g [a] = f a) := by
  refine ⟨eval f, ⟨eval_nil f, eval_append f, eval_singleton f⟩, ?_⟩
  rintro g ⟨h1, h2, h3⟩
  exact eval_unique f g h1 h2 h3

/-- Evaluation commutes with a monoid homomorphism applied letterwise. -/
theorem eval_comp_hom {N : Type w} [Monoid N] (φ : M →* N) (f : α → M) (x : List α) :
    eval (fun a => φ (f a)) x = φ (eval f x) := by
  induction x with
  | nil => simp
  | cons a t ih => simp [ih]

/-- Evaluating into the free monoid itself with the letter embedding is the
identity: words are freely generated by their letters. -/
theorem eval_freeMonoid_of (x : List α) :
    (eval (M := FreeMonoid α) FreeMonoid.of x).toList = x := by
  induction x with
  | nil => rfl
  | cons a t ih => simpa using ih

/-- Evaluation into the additive monoid of lengths recovers the length. -/
theorem eval_length (x : List α) :
    eval (M := Multiplicative ℕ) (fun _ => Multiplicative.ofAdd 1) x
      = Multiplicative.ofAdd x.length := by
  induction x with
  | nil => rfl
  | cons a t ih => simp [ih, ← ofAdd_add, Nat.add_comm]

end UAM.Free
